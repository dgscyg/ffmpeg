+                                 aclvencFrameConfig *, void *);
+} AscendEncodeContext;
+
+static void enc_in_pool_put(AscendEncodeContext *ctx, void *dev)
+{
+    if (!dev)
+        return;
+    pthread_mutex_lock(&ctx->lock);
+    if (ctx->in_pool_count < ASCEND_ENC_POOL_SZ) {
+        ctx->in_pool[ctx->in_pool_count++] = dev;
+        pthread_mutex_unlock(&ctx->lock);
+        return;
+    }
+    pthread_mutex_unlock(&ctx->lock);
+    if (ctx->acldvppFree)
+        ctx->acldvppFree(dev);
+}
+
+static void *enc_in_pool_get(AscendEncodeContext *ctx, size_t size)
+{
+    void *dev = NULL;
+    pthread_mutex_lock(&ctx->lock);
+    if (ctx->in_pool_buf_size != size) {
+        while (ctx->in_pool_count > 0) {
+            void *old = ctx->in_pool[--ctx->in_pool_count];
+            if (old && ctx->acldvppFree)
+                ctx->acldvppFree(old);
+        }
+        ctx->in_pool_buf_size = size;
+    }
+    if (ctx->in_pool_count > 0) {
+        dev = ctx->in_pool[--ctx->in_pool_count];
+        pthread_mutex_unlock(&ctx->lock);
+        return dev;
+    }
+    pthread_mutex_unlock(&ctx->lock);
+    if (ctx->acldvppMalloc(&dev, size) != ACL_SUCCESS)
+        return NULL;
+    return dev;
+}
+
+static void enc_in_pool_clear(AscendEncodeContext *ctx)
+{
+    pthread_mutex_lock(&ctx->lock);
+    while (ctx->in_pool_count > 0) {
+        void *dev = ctx->in_pool[--ctx->in_pool_count];
+        if (dev && ctx->acldvppFree)
+            ctx->acldvppFree(dev);
+    }
+    ctx->in_pool_buf_size = 0;
+    pthread_mutex_unlock(&ctx->lock);
+}
+
+static void enc_queue_clear(AscendEncodeContext *ctx)
+{
+    pthread_mutex_lock(&ctx->lock);
+    while (ctx->queue_count > 0) {
+        AscendEncPkt *p = &ctx->queue[ctx->queue_head];
+        av_freep(&p->data);
+        ctx->queue_head = (ctx->queue_head + 1) % ASCEND_ENC_QUEUE_SZ;
+        ctx->queue_count--;
+    }
+    ctx->queue_head = ctx->queue_tail = 0;
+    pthread_mutex_unlock(&ctx->lock);
+}
+
+static void *ascend_enc_cb_thread(void *arg)
+{
+    AscendEncodeContext *ctx = arg;
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    pthread_mutex_lock(&ctx->lock);
+    ctx->callback_tid = (uint64_t)(uintptr_t)pthread_self();
+    ctx->callback_thread_started = 1;
+    pthread_cond_broadcast(&ctx->thread_started);
+    pthread_mutex_unlock(&ctx->lock);
+
+    while (atomic_load(&ctx->running))
+        ctx->aclrtProcessReport(100);
+
+    return NULL;
+}
+
+static void ascend_venc_callback(acldvppPicDesc *input,
+                                 acldvppStreamDesc *output, void *userdata)
+{
+    AscendEncMeta *meta = userdata;
+    AscendEncodeContext *ctx = meta ? meta->ctx : NULL;
+    int notified = 0;
+
+    if (input && ctx && ctx->acldvppDestroyPicDesc)
+        ctx->acldvppDestroyPicDesc(input);
+
+    if (meta && ctx) {
+        if (meta->in_dev)
+            enc_in_pool_put(ctx, meta->in_dev);
+        if (meta->hw_frame_ref)
+            av_frame_free(&meta->hw_frame_ref);
+        atomic_fetch_sub(&ctx->in_flight, 1);
+    }
+
+    if (output && ctx) {
+        void *sdata = ctx->acldvppGetStreamDescData(output);
+        uint32_t ssize = ctx->acldvppGetStreamDescSize(output);
+        uint32_t rcode = ctx->acldvppGetStreamDescRetCode
+                         ? ctx->acldvppGetStreamDescRetCode(output) : 0;
+        if (!rcode && sdata && ssize > 0) {
+            uint8_t *buf = av_malloc(ssize + AV_INPUT_BUFFER_PADDING_SIZE);
+            if (buf) {
+                memset(buf + ssize, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+                if (ctx->aclrtMemcpy(buf, ssize, sdata, ssize,
+                                     ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS)
+                    memcpy(buf, sdata, ssize);
+
+                pthread_mutex_lock(&ctx->lock);
+                if (ctx->queue_count < ASCEND_ENC_QUEUE_SZ) {
+                    AscendEncPkt *slot = &ctx->queue[ctx->queue_tail];
+                    slot->data  = buf;
+                    slot->size  = (int)ssize;
+                    slot->pts   = meta ? meta->pts : AV_NOPTS_VALUE;
+                    slot->dts   = meta ? meta->dts : AV_NOPTS_VALUE;
+                    slot->flags = (meta && meta->keyframe) ? AV_PKT_FLAG_KEY : 0;
+                    ctx->queue_tail = (ctx->queue_tail + 1) % ASCEND_ENC_QUEUE_SZ;
+                    ctx->queue_count++;
+                } else {
+                    av_free(buf);
+                }
+                pthread_cond_broadcast(&ctx->cond);
+                pthread_mutex_unlock(&ctx->lock);
+                notified = 1;
+            }
+        }
+    }
+
+    if (meta && ctx) {
+        if (!notified) {
+            pthread_mutex_lock(&ctx->lock);
+            pthread_cond_broadcast(&ctx->cond);
+            pthread_mutex_unlock(&ctx->lock);
+        }
+        av_free(meta);
+    }
+}
+
+static int enc_load_symbols(AVCodecContext *avctx)
+{
+    AscendEncodeContext *ctx = avctx->priv_data;
+    void *acl = ctx->acl_lib;
+    void *dvpp = ctx->dvpp_lib;
+
+#define LOAD_SYM(field, lib)                                                   \
+    do {                                                                       \
+        ctx->field = (void *)(lib ? dlsym(lib, #field) : NULL);                \
+        if (!ctx->field) {                                                     \
+            av_log(avctx, AV_LOG_ERROR, "[AscendEnc] missing symbol %s\n",    \
+                   #field);                                                    \
+            return AVERROR_EXTERNAL;                                           \
+        }                                                                      \
+    } while (0)
+
+#define LOAD_OPT_SYM(field, lib)                                               \
+    ctx->field = (void *)(lib ? dlsym(lib, #field) : NULL)
+
+    LOAD_SYM(aclrtSetCurrentContext, acl);
+    LOAD_SYM(aclrtProcessReport, acl);
+    LOAD_SYM(aclrtMallocHost, acl);
+    LOAD_SYM(aclrtFreeHost, acl);
+    LOAD_SYM(aclrtMemcpy, acl);
+
+    LOAD_SYM(acldvppMalloc, dvpp);
+    LOAD_SYM(acldvppFree, dvpp);
+
+    LOAD_SYM(acldvppCreatePicDesc, dvpp);
+    LOAD_SYM(acldvppDestroyPicDesc, dvpp);
+    LOAD_SYM(acldvppSetPicDescData, dvpp);
+    LOAD_SYM(acldvppSetPicDescSize, dvpp);
+    LOAD_SYM(acldvppSetPicDescFormat, dvpp);
+    LOAD_SYM(acldvppSetPicDescWidth, dvpp);
+    LOAD_SYM(acldvppSetPicDescHeight, dvpp);
+    LOAD_SYM(acldvppSetPicDescWidthStride, dvpp);
+    LOAD_SYM(acldvppSetPicDescHeightStride, dvpp);
+    LOAD_SYM(acldvppGetPicDescData, dvpp);
+
+    LOAD_SYM(acldvppGetStreamDescData, dvpp);
+    LOAD_SYM(acldvppGetStreamDescSize, dvpp);
+    LOAD_SYM(acldvppDestroyStreamDesc, dvpp);
+    LOAD_OPT_SYM(acldvppGetStreamDescRetCode, dvpp);
+
+    LOAD_SYM(aclvencCreateChannelDesc, dvpp);
+    LOAD_SYM(aclvencDestroyChannelDesc, dvpp);
+    LOAD_SYM(aclvencSetChannelDescThreadId, dvpp);
+    LOAD_SYM(aclvencSetChannelDescCallback, dvpp);
+    LOAD_SYM(aclvencSetChannelDescEnType, dvpp);
+    LOAD_SYM(aclvencSetChannelDescPicFormat, dvpp);
+    LOAD_SYM(aclvencSetChannelDescPicWidth, dvpp);
+    LOAD_SYM(aclvencSetChannelDescPicHeight, dvpp);
+    LOAD_SYM(aclvencSetChannelDescKeyFrameInterval, dvpp);
+    LOAD_OPT_SYM(aclvencSetChannelDescRcMode, dvpp);
+    LOAD_OPT_SYM(aclvencSetChannelDescSrcRate, dvpp);
+    LOAD_OPT_SYM(aclvencSetChannelDescMaxBitRate, dvpp);
+    LOAD_SYM(aclvencCreateChannel, dvpp);
+    LOAD_SYM(aclvencDestroyChannel, dvpp);
+
+    LOAD_SYM(aclvencCreateFrameConfig, dvpp);
+    LOAD_SYM(aclvencDestroyFrameConfig, dvpp);
+    LOAD_SYM(aclvencSetFrameConfigForceIFrame, dvpp);
+    LOAD_SYM(aclvencSetFrameConfigEos, dvpp);
+    LOAD_SYM(aclvencSendFrame, dvpp);
+
+#undef LOAD_SYM
+#undef LOAD_OPT_SYM
+    return 0;
+}
+
+static av_cold int ascend_encode_init(AVCodecContext *avctx)
+{
+    AscendEncodeContext *ctx = avctx->priv_data;
+    acldvppStreamFormat en_type;
+    uint32_t gop, fps, max_bitrate;
+    aclError ret;
+    int err;
+
+    if (avctx->width <= 0 || avctx->height <= 0) {
+        av_log(avctx, AV_LOG_ERROR, "[AscendEnc] invalid dimensions %dx%d\n",
+               avctx->width, avctx->height);
+        return AVERROR(EINVAL);
+    }
+
+    if (avctx->hw_frames_ctx) {
+        AVHWFramesContext *frames_ctx = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+        AVAscendDeviceContext *hwctx = frames_ctx->device_ctx->hwctx;
+        ctx->device_id = hwctx->device_id;
+    } else if (avctx->hw_device_ctx) {
+        AVHWDeviceContext *dev_ctx = (AVHWDeviceContext *)avctx->hw_device_ctx->data;
+        if (dev_ctx->type == AV_HWDEVICE_TYPE_ASCEND) {
+            AVAscendDeviceContext *hwctx = dev_ctx->hwctx;
+            ctx->device_id = hwctx->device_id;
+        }
+    }
+
+    atomic_init(&ctx->running, 0);
+    atomic_init(&ctx->in_flight, 0);
+    pthread_mutex_init(&ctx->lock, NULL);
+    pthread_cond_init(&ctx->cond, NULL);
+    pthread_cond_init(&ctx->thread_started, NULL);
+
+    ctx->frame = av_frame_alloc();
+    if (!ctx->frame)
+        return AVERROR(ENOMEM);
+
+    err = av_ascend_global_acquire(ctx->device_id, &ctx->acl_lib,
+                                   &ctx->dvpp_lib, (void **)&ctx->context, avctx);
+    if (err < 0)
+        return err;
+    ctx->acl_acquired = 1;
+
+    err = enc_load_symbols(avctx);
+    if (err < 0)
+        return err;
+
+    atomic_store(&ctx->running, 1);
+    if (pthread_create(&ctx->callback_thread, NULL, ascend_enc_cb_thread, ctx) != 0) {
+        atomic_store(&ctx->running, 0);
+        return AVERROR_EXTERNAL;
+    }
+    pthread_mutex_lock(&ctx->lock);
+    while (!ctx->callback_thread_started)
+        pthread_cond_wait(&ctx->thread_started, &ctx->lock);
+    pthread_mutex_unlock(&ctx->lock);
+
+    en_type = (avctx->codec_id == AV_CODEC_ID_HEVC) ? H265_MAIN_LEVEL : H264_HIGH_LEVEL;
+    gop = avctx->gop_size > 0 ? (uint32_t)avctx->gop_size : 30;
+    fps = ctx->frame_rate > 0 ? (uint32_t)ctx->frame_rate :
+          ((avctx->framerate.num > 0 && avctx->framerate.den > 0)
+          ? (uint32_t)(avctx->framerate.num / avctx->framerate.den) : 30);
+    if (fps < 1)
+        fps = 30;
+    if (ctx->rc_mode != 1 && fps < 30)
+        fps = 30;
+
+    max_bitrate = avctx->bit_rate > 0
+                  ? (uint32_t)(avctx->bit_rate / 1000)
+                  : (uint32_t)FFMAX(1000, (avctx->width * avctx->height * 2) / 1000);
+
+    ctx->channel_desc = ctx->aclvencCreateChannelDesc();
+    if (!ctx->channel_desc)
+        return AVERROR(ENOMEM);
+
+    ret  = ctx->aclvencSetChannelDescThreadId(ctx->channel_desc, ctx->callback_tid);
+    ret |= ctx->aclvencSetChannelDescCallback(ctx->channel_desc, ascend_venc_callback);
+    ret |= ctx->aclvencSetChannelDescEnType(ctx->channel_desc, en_type);
+    ret |= ctx->aclvencSetChannelDescPicFormat(ctx->channel_desc, PIXEL_FORMAT_YUV_SEMIPLANAR_420);
+    ret |= ctx->aclvencSetChannelDescPicWidth(ctx->channel_desc, FFALIGN(avctx->width, 2));
+    ret |= ctx->aclvencSetChannelDescPicHeight(ctx->channel_desc, FFALIGN(avctx->height, 2));
+    ret |= ctx->aclvencSetChannelDescKeyFrameInterval(ctx->channel_desc, gop);
+    if (ctx->aclvencSetChannelDescRcMode)
+        ctx->aclvencSetChannelDescRcMode(ctx->channel_desc, (uint32_t)ctx->rc_mode);
+    if (ctx->aclvencSetChannelDescSrcRate)
+        ctx->aclvencSetChannelDescSrcRate(ctx->channel_desc, fps);
+    if (ctx->aclvencSetChannelDescMaxBitRate)
+        ctx->aclvencSetChannelDescMaxBitRate(ctx->channel_desc, max_bitrate);
+
+    if (ret != ACL_SUCCESS ||
+        ctx->aclvencCreateChannel(ctx->channel_desc) != ACL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "[AscendEnc] aclvencCreateChannel failed\n");
+        ctx->aclvencDestroyChannelDesc(ctx->channel_desc);
+        ctx->channel_desc = NULL;
+        return AVERROR_EXTERNAL;
+    }
+
+    ctx->frame_cfg = ctx->aclvencCreateFrameConfig();
+    if (!ctx->frame_cfg)
+        return AVERROR(ENOMEM);
+
+    ctx->initialized = 1;
+    av_log(avctx, AV_LOG_INFO,
+           "[AscendEnc] DVPP VENC ready (device=%d, %dx%d, rc=%s, gop=%u, fps=%u, max_bitrate=%ukbps)\n",
+           ctx->device_id, avctx->width, avctx->height,
+           (ctx->rc_mode == 1 ? "VBR" : "CBR"), gop, fps, max_bitrate);
+    return 0;
+}
+
+static int ascend_encode_submit_frame(AVCodecContext *avctx, const AVFrame *frame)
+{
+    AscendEncodeContext *ctx = avctx->priv_data;
+    uint32_t w = FFALIGN(avctx->width, 2);
+    uint32_t h = FFALIGN(avctx->height, 2);
+    uint32_t stride_w = FFALIGN(w, ASCEND_ENC_ALIGN_W);
+    uint32_t stride_h = FFALIGN(h, ASCEND_ENC_ALIGN_H);
+    size_t y_size, uv_size, buf_size;
+    void *in_dev = NULL;
+    void *pic_dev = NULL;
+    AVFrame *hw_ref = NULL;
+    acldvppPicDesc *pic = NULL;
+    AscendEncMeta *meta = NULL;
+    int keyframe = (frame->pict_type == AV_PICTURE_TYPE_I) ||
+                   (frame->flags & AV_FRAME_FLAG_KEY);
+
+    if (frame->format == AV_PIX_FMT_ASCEND) {
+        uint32_t src_sw = (uint32_t)frame->linesize[0];
+        uint32_t src_sh = (frame->data[1] > frame->data[0] && src_sw > 0)
+                          ? (uint32_t)((frame->data[1] - frame->data[0]) / src_sw)
+                          : stride_h;
+        /*
+         * Accept any upstream stride matching CANN 16-width and 2-height alignment.
+         * Decoder / VPC output 128-aligned frames are zero-copy passed through directly.
+         */
+        if (src_sw >= w && (src_sw % 16) == 0 && src_sh >= h && (src_sh % 2) == 0) {
+            hw_ref = av_frame_clone(frame);
+            if (!hw_ref)
+                return AVERROR(ENOMEM);
+            pic_dev  = hw_ref->data[0];
+            stride_w = src_sw;
+            stride_h = src_sh;
+            y_size   = (size_t)stride_w * stride_h;
+            uv_size  = (size_t)stride_w * (stride_h / 2);
+            buf_size = y_size + uv_size;
+        } else {
+            y_size   = (size_t)stride_w * stride_h;
+            uv_size  = (size_t)stride_w * (stride_h / 2);
+            buf_size = y_size + uv_size;
+            in_dev   = enc_in_pool_get(ctx, buf_size);
+            if (!in_dev)
+                return AVERROR(ENOMEM);
+            for (uint32_t row = 0; row < h; row++) {
+                ctx->aclrtMemcpy((uint8_t *)in_dev + (size_t)row * stride_w, stride_w,
+                                 frame->data[0] + (size_t)row * src_sw, w,
+                                 ACL_MEMCPY_DEVICE_TO_DEVICE);
+            }
+            for (uint32_t row = 0; row < h / 2; row++) {
+                ctx->aclrtMemcpy((uint8_t *)in_dev + y_size + (size_t)row * stride_w, stride_w,
+                                 frame->data[1] + (size_t)row * src_sw, w,
+                                 ACL_MEMCPY_DEVICE_TO_DEVICE);
+            }
+            pic_dev = in_dev;
+        }
+    } else if (frame->format == AV_PIX_FMT_NV12) {
+        y_size   = (size_t)stride_w * stride_h;
+        uv_size  = (size_t)stride_w * (stride_h / 2);
+        buf_size = y_size + uv_size;
+        in_dev   = enc_in_pool_get(ctx, buf_size);
+        if (!in_dev)
+            return AVERROR(ENOMEM);
+        if (frame->linesize[0] == (int)stride_w && frame->linesize[1] == (int)stride_w) {
+            if (ctx->aclrtMemcpy(in_dev, (size_t)stride_w * h,
+                                 frame->data[0], (size_t)stride_w * h,
+                                 ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
+                ctx->aclrtMemcpy((uint8_t *)in_dev + y_size, (size_t)stride_w * (h / 2),
+                                 frame->data[1], (size_t)stride_w * (h / 2),
+                                 ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
+                enc_in_pool_put(ctx, in_dev);
+                return AVERROR_EXTERNAL;
+            }
+        } else {
+            if (!ctx->host_stage_buf || ctx->host_stage_size < buf_size) {
+                if (ctx->host_stage_buf && ctx->aclrtFreeHost)
+                    ctx->aclrtFreeHost(ctx->host_stage_buf);
+                ctx->host_stage_buf = NULL;
+                ctx->host_stage_size = 0;
+                if (ctx->aclrtMallocHost(&ctx->host_stage_buf, buf_size) != ACL_SUCCESS ||
+                    !ctx->host_stage_buf) {
+                    enc_in_pool_put(ctx, in_dev);
+                    return AVERROR(ENOMEM);
+                }
+                ctx->host_stage_size = buf_size;
+            }
+            av_image_copy_plane((uint8_t *)ctx->host_stage_buf, stride_w,
+                                frame->data[0], frame->linesize[0], w, h);
+            av_image_copy_plane((uint8_t *)ctx->host_stage_buf + y_size, stride_w,
+                                frame->data[1], frame->linesize[1], w, h / 2);
+            if (ctx->aclrtMemcpy(in_dev, buf_size, ctx->host_stage_buf, buf_size,
+                                 ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
+                enc_in_pool_put(ctx, in_dev);
+                return AVERROR_EXTERNAL;
+            }
+        }
+        pic_dev = in_dev;
+    } else {
+        return AVERROR(EINVAL);
+    }
+
+    pic = ctx->acldvppCreatePicDesc();
+    if (!pic) {
+        if (in_dev)
+            enc_in_pool_put(ctx, in_dev);
+        av_frame_free(&hw_ref);
+        return AVERROR(ENOMEM);
+    }
+    ctx->acldvppSetPicDescData(pic, pic_dev);
+    ctx->acldvppSetPicDescSize(pic, buf_size);
+    ctx->acldvppSetPicDescFormat(pic, PIXEL_FORMAT_YUV_SEMIPLANAR_420);
+    ctx->acldvppSetPicDescWidth(pic, w);
+    ctx->acldvppSetPicDescHeight(pic, h);
+    ctx->acldvppSetPicDescWidthStride(pic, stride_w);
+    ctx->acldvppSetPicDescHeightStride(pic, stride_h);
+
+    meta = av_mallocz(sizeof(*meta));
+    if (!meta) {
+        ctx->acldvppDestroyPicDesc(pic);
+        if (in_dev)
+            enc_in_pool_put(ctx, in_dev);
+        av_frame_free(&hw_ref);
+        return AVERROR(ENOMEM);
+    }
+    meta->ctx          = ctx;
+    meta->in_dev       = in_dev;
+    meta->hw_frame_ref = hw_ref;
+    meta->pts          = frame->pts;
+    meta->dts          = frame->pts;
+    meta->keyframe     = keyframe;
+
+    ctx->aclvencSetFrameConfigEos(ctx->frame_cfg, 0);
+    ctx->aclvencSetFrameConfigForceIFrame(ctx->frame_cfg, keyframe ? 1 : 0);
+
+    atomic_fetch_add(&ctx->in_flight, 1);
+    for (int attempts = 0;;) {
+        aclError acl_ret = ctx->aclvencSendFrame(ctx->channel_desc, pic, NULL,
+                                                 ctx->frame_cfg, meta);
+        if (acl_ret == ACL_SUCCESS)
+            break;
+        if ((int)acl_ret == ASCEND_VENC_BUF_FULL && attempts++ < 5000 &&
+            atomic_load(&ctx->running)) {
+            av_usleep(1000);
+            continue;
+        }
+        atomic_fetch_sub(&ctx->in_flight, 1);
+        ctx->acldvppDestroyPicDesc(pic);
+        if (in_dev)
+            enc_in_pool_put(ctx, in_dev);
+        av_frame_free(&hw_ref);
+        av_free(meta);
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+static int ascend_encode_receive_packet(AVCodecContext *avctx, AVPacket *pkt)
+{
+    AscendEncodeContext *ctx = avctx->priv_data;
+    int poll_waited = 0;
+    int sent_frame = 0;
+    int waited_ms = 0;
+    int ret;
+
+    if (!ctx->initialized)
+        return AVERROR(EINVAL);
+    if (ctx->context)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    while (!ctx->eof_sent) {
+        ret = ff_encode_get_frame(avctx, ctx->frame);
+        if (ret == AVERROR_EOF) {
+            ctx->eof_sent = 1;
+            ctx->aclvencSetFrameConfigEos(ctx->frame_cfg, 1);
+            ctx->aclvencSetFrameConfigForceIFrame(ctx->frame_cfg, 0);
+            for (int attempts = 0;;) {
+                aclError acl_ret = ctx->aclvencSendFrame(ctx->channel_desc, NULL,
+                                                         NULL, ctx->frame_cfg, NULL);
+                if (acl_ret == ACL_SUCCESS)
+                    break;
+                if ((int)acl_ret == ASCEND_VENC_BUF_FULL && attempts++ < 5000 &&
+                    atomic_load(&ctx->running)) {
+                    av_usleep(1000);
+                    continue;
+                }
+                return AVERROR_EXTERNAL;
+            }
+            break;
+        } else if (ret == AVERROR(EAGAIN)) {
+            break;
+        } else if (ret < 0) {
+            return ret;
+        }
+
+        ret = ascend_encode_submit_frame(avctx, ctx->frame);
+        av_frame_unref(ctx->frame);
+        if (ret < 0)
+            return ret;
+        sent_frame = 1;
+    }
+
+    for (;;) {
+        pthread_mutex_lock(&ctx->lock);
+        if (ctx->queue_count > 0) {
+            AscendEncPkt item = ctx->queue[ctx->queue_head];
+            ctx->queue_head = (ctx->queue_head + 1) % ASCEND_ENC_QUEUE_SZ;
+            ctx->queue_count--;
+            pthread_mutex_unlock(&ctx->lock);
+
+            ret = av_packet_from_data(pkt, item.data, item.size);
+            if (ret < 0) {
+                av_free(item.data);
+                return ret;
+            }
+            pkt->pts   = item.pts;
+            pkt->dts   = item.dts;
+            pkt->flags = item.flags;
+            return 0;
+        }
+        if (ctx->eos_done) {
+            pthread_mutex_unlock(&ctx->lock);
+            return AVERROR_EOF;
+        }
+        if (!ctx->eof_sent) {
+            int inflight = atomic_load(&ctx->in_flight);
+            if (sent_frame && !poll_waited && inflight >= 8) {
+                struct timespec ts;
+                long wait_ns = (inflight >= 24 ? 50L : 5L) * 1000000L;
+                poll_waited = 1;
+                clock_gettime(CLOCK_REALTIME, &ts);
+                ts.tv_nsec += wait_ns;
+                if (ts.tv_nsec >= 1000000000L) {
+                    ts.tv_sec++;
+                    ts.tv_nsec -= 1000000000L;
+                }
+                pthread_cond_timedwait(&ctx->cond, &ctx->lock, &ts);
+                pthread_mutex_unlock(&ctx->lock);
+                continue;
+            }
+            pthread_mutex_unlock(&ctx->lock);
+            return AVERROR(EAGAIN);
+        }
+        if (!atomic_load(&ctx->in_flight)) {
+            ctx->eos_done = 1;
+            pthread_mutex_unlock(&ctx->lock);
+            return AVERROR_EOF;
+        }
+        {
+            struct timespec ts;
+            clock_gettime(CLOCK_REALTIME, &ts);
+            ts.tv_nsec += 20 * 1000000;
+            if (ts.tv_nsec >= 1000000000) {
+                ts.tv_sec++;
+                ts.tv_nsec -= 1000000000;
+            }
+            pthread_cond_timedwait(&ctx->cond, &ctx->lock, &ts);
+        }
+        if (ctx->queue_count > 0) {
+            pthread_mutex_unlock(&ctx->lock);
+            continue;
+        }
+        waited_ms += 20;
+        if (waited_ms >= 1000) {
+            ctx->eos_done = 1;
+            pthread_mutex_unlock(&ctx->lock);
+            return AVERROR_EOF;
+        }
+        pthread_mutex_unlock(&ctx->lock);
+    }
+}
+
+static av_cold int ascend_encode_close(AVCodecContext *avctx)
+{
+    AscendEncodeContext *ctx = avctx->priv_data;
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    if (ctx->channel_desc) {
+        if (ctx->aclvencDestroyChannel)
+            ctx->aclvencDestroyChannel(ctx->channel_desc);
+        if (ctx->aclvencDestroyChannelDesc)
+            ctx->aclvencDestroyChannelDesc(ctx->channel_desc);
+        ctx->channel_desc = NULL;
+    }
+    if (ctx->frame_cfg && ctx->aclvencDestroyFrameConfig) {
+        ctx->aclvencDestroyFrameConfig(ctx->frame_cfg);
+        ctx->frame_cfg = NULL;
+    }
+    if (ctx->callback_thread_started) {
+        atomic_store(&ctx->running, 0);
+        pthread_join(ctx->callback_thread, NULL);
+        ctx->callback_thread_started = 0;
+    }
+    enc_queue_clear(ctx);
+    enc_in_pool_clear(ctx);
+    if (ctx->host_stage_buf && ctx->aclrtFreeHost)
+        ctx->aclrtFreeHost(ctx->host_stage_buf);
+    ctx->host_stage_buf = NULL;
+    ctx->host_stage_size = 0;
+    av_frame_free(&ctx->frame);
+    if (ctx->acl_acquired) {
+        av_ascend_global_release(ctx->device_id, ctx->context);
+        ctx->context = NULL;
+        ctx->acl_acquired = 0;
+    }
+
+    pthread_cond_destroy(&ctx->thread_started);
+    pthread_cond_destroy(&ctx->cond);
+    pthread_mutex_destroy(&ctx->lock);
+    return 0;
+}
