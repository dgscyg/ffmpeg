+_Static_assert(sizeof(ff_hi_vdec_pic_info) == 48, "hi_vdec_pic_info ABI size");
+_Static_assert(offsetof(ff_hi_vdec_pic_info, vir_addr) == 24, "hi_vdec_pic_info.vir_addr ABI offset");
+_Static_assert(sizeof(ff_hi_video_frame) == 320, "hi_video_frame ABI size");
+_Static_assert(sizeof(ff_hi_video_frame_info) == 328, "hi_video_frame_info ABI size");
+_Static_assert(offsetof(ff_hi_video_frame, width_stride) == 44, "hi_video_frame.width_stride ABI offset");
+_Static_assert(offsetof(ff_hi_video_frame, height_stride) == 56, "hi_video_frame.height_stride ABI offset");
+_Static_assert(offsetof(ff_hi_video_frame, virt_addr) == 144, "hi_video_frame.virt_addr ABI offset");
+_Static_assert(offsetof(ff_hi_video_frame, pts) == 176, "hi_video_frame.pts ABI offset");
+_Static_assert(offsetof(ff_hi_video_frame, frame_flag) == 200, "hi_video_frame.frame_flag ABI offset");
+_Static_assert(sizeof(ff_hi_vdec_supplement_info) == 16, "hi_vdec_supplement_info ABI size");
+
+typedef struct AscendMpiSyms {
+    void *mpi_lib;
+    int sys_inited;
+    ff_hi_s32 (*hi_mpi_sys_init)(void);
+    ff_hi_s32 (*hi_mpi_dvpp_malloc)(ff_hi_u32 dev_id, void **dev_ptr, ff_hi_u64 size);
+    ff_hi_s32 (*hi_mpi_dvpp_free)(void *dev_ptr);
+    ff_hi_s32 (*hi_mpi_vdec_create_chn)(ff_hi_vdec_chn chn, const ff_hi_vdec_chn_attr *attr);
+    ff_hi_s32 (*hi_mpi_vdec_destroy_chn)(ff_hi_vdec_chn chn);
+    ff_hi_s32 (*hi_mpi_vdec_start_recv_stream)(ff_hi_vdec_chn chn);
+    ff_hi_s32 (*hi_mpi_vdec_stop_recv_stream)(ff_hi_vdec_chn chn);
+    ff_hi_s32 (*hi_mpi_vdec_reset_chn)(ff_hi_vdec_chn chn);
+    ff_hi_s32 (*hi_mpi_vdec_send_stream)(ff_hi_vdec_chn chn, const ff_hi_vdec_stream *stream,
+                                         ff_hi_vdec_pic_info *pic_info, ff_hi_s32 milli_sec);
+    ff_hi_s32 (*hi_mpi_vdec_get_frame)(ff_hi_vdec_chn chn, ff_hi_video_frame_info *frame_info,
+                                       ff_hi_vdec_supplement_info *supplement,
+                                       ff_hi_vdec_stream *stream, ff_hi_s32 milli_sec);
+    ff_hi_s32 (*hi_mpi_vdec_release_frame)(ff_hi_vdec_chn chn, const ff_hi_video_frame_info *frame_info);
+} AscendMpiSyms;
+
+static pthread_mutex_t ascend_v2_lock = PTHREAD_MUTEX_INITIALIZER;
+static AscendMpiSyms ascend_mpi;
+static uint64_t ascend_chn_bitmap[FF_HI_VDEC_MAX_CHN_NUM / 64];
+static uint32_t ascend_chn_cursor;
+
+typedef struct AscendInBuf {
+    void *ptr;
+    size_t cap;
+} AscendInBuf;
+
+/*
+ * Reference-counted Ascend device context holder.
+ * Keeps the ACL context and hi_mpi_dvpp_free alive as long as downstream
+ * zero-copy AVFrames still reference an AscendOutPool.
+ */
+typedef struct AscendContextRef {
+    atomic_int refs;
+    int device_id;
+    int host_alloc_warned;
+    aclrtContext context;
+    aclError (*aclrtSetCurrentContext)(aclrtContext);
+    ff_hi_s32 (*hi_mpi_dvpp_free)(void *);
+} AscendContextRef;
+
+typedef struct AscendOutPool {
+    atomic_int refs;
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+    int closed;
+    int max_bufs;
+    AscendContextRef *cref;
+    void *bufs[ASCEND_OUT_POOL_SIZE];
+    int count;
+    int allocated;
+    size_t buf_size;
+} AscendOutPool;
+
+typedef struct AscendDecodeContext {
+    const AVClass *class;
+
+    void *acl_lib;
+
+    int device_id;
+    int channel_id;
+    int active_chn;
+    int channel_created;
+    int device_output;
+    int max_out_bufs;
+    int codec_id;
+    int initialized;
+    int extradata_sent;
+
+    AscendContextRef *cref;
+    aclrtContext context;
+    int channel_width;
+    int channel_height;
+
+    AVBufferRef *hw_device_ref;
+    AVBufferRef *hw_frames_ref;
+
+    int in_flight;
