+/*
+ * Huawei Ascend DVPP VPC hardware scaling filter (scale_ascend).
+ *
+ * Operates directly on AV_PIX_FMT_ASCEND device surfaces in NPU DVPP memory
+ * with zero PCIe D2H/H2D round-trip.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdint.h>
+#include <string.h>
+
+#include "libavutil/buffer.h"
+#include "libavutil/common.h"
+#include "libavutil/error.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_ascend.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+#include "libavutil/internal.h"
+
+#include "avfilter.h"
+#include "filters.h"
+#include "scale_eval.h"
+#include "video.h"
+
+#include <acl/acl.h>
+#include <acl/ops/acl_dvpp.h>
+
+#ifndef _WIN32
+#include <dlfcn.h>
+#endif
+
+typedef struct ScaleAscendContext {
+    const AVClass *class;
+
+    char *w_expr;
+    char *h_expr;
+    int output_width;
+    int output_height;
+    int passthrough;
+    int interp;
+
+    acldvppChannelDesc *vpc_channel;
+    acldvppResizeConfig *resize_cfg;
+    acldvppPicDesc *in_pic;
+    acldvppPicDesc *out_pic;
+
+    aclError (*aclrtSetCurrentContext)(aclrtContext);
+    aclError (*aclrtSynchronizeStream)(aclrtStream);
+
+    acldvppChannelDesc *(*acldvppCreateChannelDesc)(void);
+    aclError (*acldvppDestroyChannelDesc)(acldvppChannelDesc *);
+    aclError (*acldvppCreateChannel)(acldvppChannelDesc *);
+    aclError (*acldvppDestroyChannel)(acldvppChannelDesc *);
+
+    acldvppResizeConfig *(*acldvppCreateResizeConfig)(void);
+    aclError (*acldvppDestroyResizeConfig)(acldvppResizeConfig *);
+    aclError (*acldvppSetResizeConfigInterpolation)(acldvppResizeConfig *, uint32_t);
+
+    acldvppPicDesc *(*acldvppCreatePicDesc)(void);
+    aclError (*acldvppDestroyPicDesc)(acldvppPicDesc *);
+    aclError (*acldvppSetPicDescData)(acldvppPicDesc *, void *);
+    aclError (*acldvppSetPicDescSize)(acldvppPicDesc *, uint32_t);
+    aclError (*acldvppSetPicDescFormat)(acldvppPicDesc *, acldvppPixelFormat);
+    aclError (*acldvppSetPicDescWidth)(acldvppPicDesc *, uint32_t);
+    aclError (*acldvppSetPicDescHeight)(acldvppPicDesc *, uint32_t);
+    aclError (*acldvppSetPicDescWidthStride)(acldvppPicDesc *, uint32_t);
+    aclError (*acldvppSetPicDescHeightStride)(acldvppPicDesc *, uint32_t);
+
+    aclError (*acldvppVpcResizeAsync)(acldvppChannelDesc *, acldvppPicDesc *,
+                                      acldvppPicDesc *, acldvppResizeConfig *,
+                                      aclrtStream);
+} ScaleAscendContext;
+
+#ifndef _WIN32
+
+static void scale_ascend_destroy_vpc(ScaleAscendContext *s)
+{
+    if (s->in_pic && s->acldvppDestroyPicDesc) {
+        s->acldvppDestroyPicDesc(s->in_pic);
+        s->in_pic = NULL;
+    }
+    if (s->out_pic && s->acldvppDestroyPicDesc) {
+        s->acldvppDestroyPicDesc(s->out_pic);
+        s->out_pic = NULL;
+    }
+    if (s->resize_cfg && s->acldvppDestroyResizeConfig) {
+        s->acldvppDestroyResizeConfig(s->resize_cfg);
+        s->resize_cfg = NULL;
+    }
+    if (s->vpc_channel) {
+        if (s->acldvppDestroyChannel)
+            s->acldvppDestroyChannel(s->vpc_channel);
+        if (s->acldvppDestroyChannelDesc)
+            s->acldvppDestroyChannelDesc(s->vpc_channel);
+        s->vpc_channel = NULL;
+    }
+}
+
+static int scale_ascend_load_syms(AVFilterContext *avctx,
+                                  AVAscendDeviceContext *hwctx)
+{
+    ScaleAscendContext *s = avctx->priv;
+    void *acl = hwctx->acl_lib;
+    void *dvpp = hwctx->dvpp_lib;
+
+#define LOAD_SYM(field, lib)                                                  \
+    do {                                                                      \
+        s->field = (void *)(lib ? dlsym(lib, #field) : NULL);                 \
+        if (!s->field) {                                                      \
+            av_log(avctx, AV_LOG_ERROR, "[scale_ascend] missing symbol %s\n",\
+                   #field);                                                   \
+            return AVERROR_EXTERNAL;                                          \
+        }                                                                     \
+    } while (0)
+
+    LOAD_SYM(aclrtSetCurrentContext, acl);
+    LOAD_SYM(aclrtSynchronizeStream, acl);
+
+    LOAD_SYM(acldvppCreateChannelDesc, dvpp);
+    LOAD_SYM(acldvppDestroyChannelDesc, dvpp);
+    LOAD_SYM(acldvppCreateChannel, dvpp);
+    LOAD_SYM(acldvppDestroyChannel, dvpp);
+
+    LOAD_SYM(acldvppCreateResizeConfig, dvpp);
+    LOAD_SYM(acldvppDestroyResizeConfig, dvpp);
+    s->acldvppSetResizeConfigInterpolation =
+        (void *)dlsym(dvpp, "acldvppSetResizeConfigInterpolation");
+
+    LOAD_SYM(acldvppCreatePicDesc, dvpp);
+    LOAD_SYM(acldvppDestroyPicDesc, dvpp);
+    LOAD_SYM(acldvppSetPicDescData, dvpp);
+    LOAD_SYM(acldvppSetPicDescSize, dvpp);
+    LOAD_SYM(acldvppSetPicDescFormat, dvpp);
+    LOAD_SYM(acldvppSetPicDescWidth, dvpp);
+    LOAD_SYM(acldvppSetPicDescHeight, dvpp);
+    LOAD_SYM(acldvppSetPicDescWidthStride, dvpp);
+    LOAD_SYM(acldvppSetPicDescHeightStride, dvpp);
+    LOAD_SYM(acldvppVpcResizeAsync, dvpp);
+#undef LOAD_SYM
+
+    return 0;
+}
+
+static av_cold void scale_ascend_uninit(AVFilterContext *avctx)
+{
+    ScaleAscendContext *s = avctx->priv;
+    scale_ascend_destroy_vpc(s);
+}
+
+static int scale_ascend_config_output(AVFilterLink *outlink)
+{
+    FilterLink *outl = ff_filter_link(outlink);
+    AVFilterContext *avctx = outlink->src;
+    ScaleAscendContext *s = avctx->priv;
+    AVFilterLink *inlink = avctx->inputs[0];
+    FilterLink *inl = ff_filter_link(inlink);
+    AVHWFramesContext *hw_frame_ctx_in;
+    AVHWFramesContext *hw_frame_ctx_out;
+    AVAscendDeviceContext *hwctx;
+    int err;
+
+    if (!inl->hw_frames_ctx) {
+        av_log(avctx, AV_LOG_ERROR, "[scale_ascend] input requires hw_frames_ctx\n");
+        return AVERROR(EINVAL);
+    }
+
+    err = ff_scale_eval_dimensions(s, s->w_expr, s->h_expr, inlink, outlink,
+                                   &s->output_width, &s->output_height);
+    if (err < 0)
+        return err;
+
+    err = ff_scale_adjust_dimensions(inlink, &s->output_width, &s->output_height,
+                                     SCALE_FORCE_OAR_DISABLE, 2, 1.f);
+    if (err < 0)
+        return err;
+
+    /* DVPP VPC requires even width and height, minimum 16x16. */
+    s->output_width  = FFMAX(FFALIGN(s->output_width, 2), 16);
+    s->output_height = FFMAX(FFALIGN(s->output_height, 2), 16);
+
+    outlink->w = s->output_width;
+    outlink->h = s->output_height;
+
+    if (inlink->sample_aspect_ratio.num) {
+        AVRational r = { outlink->h * inlink->w, outlink->w * inlink->h };
+        outlink->sample_aspect_ratio = av_mul_q(r, inlink->sample_aspect_ratio);
+    } else {
+        outlink->sample_aspect_ratio = inlink->sample_aspect_ratio;
+    }
+
+    hw_frame_ctx_in = (AVHWFramesContext *)inl->hw_frames_ctx->data;
+    hwctx = hw_frame_ctx_in->device_ctx->hwctx;
+
+    /* Always destroy previous VPC state before reconfiguring */
+    scale_ascend_destroy_vpc(s);
+
+    if (inlink->w == outlink->w && inlink->h == outlink->h) {
+        s->passthrough = 1;
+        av_buffer_unref(&outl->hw_frames_ctx);
+        outl->hw_frames_ctx = av_buffer_ref(inl->hw_frames_ctx);
+        return outl->hw_frames_ctx ? 0 : AVERROR(ENOMEM);
+    }
+    s->passthrough = 0;
+
+    err = scale_ascend_load_syms(avctx, hwctx);
+    if (err < 0)
+        return err;
+
+    if (hwctx->context)
+        s->aclrtSetCurrentContext(hwctx->context);
+
+    s->vpc_channel = s->acldvppCreateChannelDesc();
+    if (!s->vpc_channel)
+        return AVERROR(ENOMEM);
+    if (s->acldvppCreateChannel(s->vpc_channel) != ACL_SUCCESS) {
+        s->acldvppDestroyChannelDesc(s->vpc_channel);
+        s->vpc_channel = NULL;
+        av_log(avctx, AV_LOG_ERROR, "[scale_ascend] acldvppCreateChannel failed\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    s->resize_cfg = s->acldvppCreateResizeConfig();
+    if (!s->resize_cfg) {
+        scale_ascend_destroy_vpc(s);
+        return AVERROR(ENOMEM);
+    }
+    if (s->acldvppSetResizeConfigInterpolation && s->interp >= 0)
+        s->acldvppSetResizeConfigInterpolation(s->resize_cfg, (uint32_t)s->interp);
+
+    s->in_pic  = s->acldvppCreatePicDesc();
+    s->out_pic = s->acldvppCreatePicDesc();
+    if (!s->in_pic || !s->out_pic) {
+        scale_ascend_destroy_vpc(s);
+        return AVERROR(ENOMEM);
+    }
+
+    av_buffer_unref(&outl->hw_frames_ctx);
+    outl->hw_frames_ctx = av_hwframe_ctx_alloc(hw_frame_ctx_in->device_ref);
+    if (!outl->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+
+    hw_frame_ctx_out = (AVHWFramesContext *)outl->hw_frames_ctx->data;
+    hw_frame_ctx_out->format    = AV_PIX_FMT_ASCEND;
+    hw_frame_ctx_out->sw_format = hw_frame_ctx_in->sw_format;
+    hw_frame_ctx_out->width     = outlink->w;
+    hw_frame_ctx_out->height    = outlink->h;
+
+    err = ff_filter_init_hw_frames(avctx, outlink, 4);
+    if (err < 0)
+        return err;
+
+    err = av_hwframe_ctx_init(outl->hw_frames_ctx);
+    if (err < 0) {
+        av_log(avctx, AV_LOG_ERROR, "[scale_ascend] av_hwframe_ctx_init failed\n");
+        return err;
+    }
+
+    return 0;
+}
+
+static int scale_ascend_filter_frame(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *avctx = inlink->dst;
+    ScaleAscendContext *s = avctx->priv;
+    AVFilterLink *outlink = avctx->outputs[0];
+    FilterLink *outl = ff_filter_link(outlink);
+    AVHWFramesContext *frames_ctx = (AVHWFramesContext *)outl->hw_frames_ctx->data;
+    AVAscendDeviceContext *hwctx = frames_ctx->device_ctx->hwctx;
+    AVFrame *out = NULL;
+    uint32_t in_w, in_h, in_stride_w, in_stride_h, in_size;
+    uint32_t out_w, out_h, out_stride_w, out_stride_h, out_size;
+    int ret;
+
+    if (s->passthrough)
+        return ff_filter_frame(outlink, in);
+
+    if (hwctx->context)
+        s->aclrtSetCurrentContext(hwctx->context);
+
+    out = av_frame_alloc();
+    if (!out) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+
+    ret = av_hwframe_get_buffer(outl->hw_frames_ctx, out, 0);
+    if (ret < 0)
+        goto fail;
+
+    in_w        = FFALIGN(in->width, 2);
+    in_h        = FFALIGN(in->height, 2);
+    in_stride_w = (uint32_t)in->linesize[0];
+    in_stride_h = (in->data[1] > in->data[0] && in_stride_w > 0)
+                  ? (uint32_t)((in->data[1] - in->data[0]) / in_stride_w)
+                  : FFALIGN(in_h, ASCEND_ALIGN_H);
+    in_size     = in_stride_w * in_stride_h * 3 / 2;
+
+    out_w        = FFALIGN(out->width, 2);
+    out_h        = FFALIGN(out->height, 2);
+    out_stride_w = (uint32_t)out->linesize[0];
+    out_stride_h = (out->data[1] > out->data[0] && out_stride_w > 0)
+                   ? (uint32_t)((out->data[1] - out->data[0]) / out_stride_w)
+                   : FFALIGN(out_h, ASCEND_ALIGN_H);
+    out_size     = out_stride_w * out_stride_h * 3 / 2;
+
+    s->acldvppSetPicDescData(s->in_pic, in->data[0]);
+    s->acldvppSetPicDescSize(s->in_pic, in_size);
+    s->acldvppSetPicDescFormat(s->in_pic, PIXEL_FORMAT_YUV_SEMIPLANAR_420);
+    s->acldvppSetPicDescWidth(s->in_pic, in_w);
+    s->acldvppSetPicDescHeight(s->in_pic, in_h);
+    s->acldvppSetPicDescWidthStride(s->in_pic, in_stride_w);
+    s->acldvppSetPicDescHeightStride(s->in_pic, in_stride_h);
+
+    s->acldvppSetPicDescData(s->out_pic, out->data[0]);
+    s->acldvppSetPicDescSize(s->out_pic, out_size);
+    s->acldvppSetPicDescFormat(s->out_pic, PIXEL_FORMAT_YUV_SEMIPLANAR_420);
+    s->acldvppSetPicDescWidth(s->out_pic, out_w);
+    s->acldvppSetPicDescHeight(s->out_pic, out_h);
+    s->acldvppSetPicDescWidthStride(s->out_pic, out_stride_w);
+    s->acldvppSetPicDescHeightStride(s->out_pic, out_stride_h);
+
+    if (s->acldvppVpcResizeAsync(s->vpc_channel, s->in_pic, s->out_pic,
+                                 s->resize_cfg, hwctx->stream) != ACL_SUCCESS ||
+        s->aclrtSynchronizeStream(hwctx->stream) != ACL_SUCCESS) {
+        av_log(avctx, AV_LOG_ERROR, "[scale_ascend] acldvppVpcResizeAsync failed\n");
+        ret = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    ret = av_frame_copy_props(out, in);
+    if (ret < 0)
+        goto fail;
+
+    av_frame_free(&in);
+    return ff_filter_frame(outlink, out);
+
+fail:
+    av_frame_free(&in);
+    av_frame_free(&out);
+    return ret;
+}
