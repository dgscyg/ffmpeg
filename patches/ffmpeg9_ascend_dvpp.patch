+typedef struct AscendGlobalSyms {
+    void *acl_lib;
+    void *dvpp_lib;
+    aclError (*aclInit)(const char *);
+    aclError (*aclFinalize)(void);
+    aclError (*aclrtSetDevice)(int32_t);
+    aclError (*aclrtResetDevice)(int32_t);
+    aclError (*aclrtCreateContext)(aclrtContext *, int32_t);
+    aclError (*aclrtDestroyContext)(aclrtContext);
+    aclError (*aclrtSetCurrentContext)(aclrtContext);
+    aclError (*aclrtCreateStream)(aclrtStream *);
+    aclError (*aclrtDestroyStream)(aclrtStream);
+    aclError (*aclrtSynchronizeStream)(aclrtStream);
+    aclError (*aclrtMallocHost)(void **, size_t);
+    aclError (*aclrtFreeHost)(void *);
+    aclError (*aclrtMemcpy)(void *, size_t, const void *, size_t, aclrtMemcpyKind);
+    aclError (*acldvppMalloc)(void **, size_t);
+    aclError (*acldvppFree)(void *);
+} AscendGlobalSyms;
+
+static pthread_mutex_t ascend_global_lock = PTHREAD_MUTEX_INITIALIZER;
+static int ascend_acl_refs;
+static int ascend_device_refs[64];
+static aclrtContext ascend_device_contexts[64];
+static AscendGlobalSyms ascend_syms;
+
+static void *load_dyn_lib(const char *name)
+{
+    void *h = dlopen(name, RTLD_NOW | RTLD_GLOBAL);
+    const char *paths[] = {
+        "/usr/local/Ascend/ascend-toolkit/latest/lib64",
+        "/usr/local/Ascend/ascend-toolkit/latest/runtime/lib64",
+        "/usr/local/Ascend/nnae/latest/lib64",
+        "/usr/local/Ascend/driver/lib64",
+        "/usr/local/Ascend/ascend-toolkit/lib64",
+        NULL
+    };
+    char buf[512];
+
+    if (h)
+        return h;
+    for (int i = 0; paths[i]; i++) {
+        snprintf(buf, sizeof(buf), "%s/%s", paths[i], name);
+        h = dlopen(buf, RTLD_NOW | RTLD_GLOBAL);
+        if (h)
+            return h;
+    }
+    return NULL;
+}
+
+static int ensure_global_syms_locked(void *log_ctx)
+{
+    if (ascend_syms.acl_lib && ascend_syms.dvpp_lib)
+        return 0;
+
+    if (!ascend_syms.acl_lib)
+        ascend_syms.acl_lib = load_dyn_lib("libascendcl.so");
+    if (!ascend_syms.acl_lib) {
+        av_log(log_ctx, AV_LOG_ERROR, "[Ascend] libascendcl.so not found\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    if (!ascend_syms.dvpp_lib) {
+        ascend_syms.dvpp_lib = load_dyn_lib("libacl_dvpp.so");
+        if (!ascend_syms.dvpp_lib)
+            ascend_syms.dvpp_lib = load_dyn_lib("libacl_dvpp_mpi.so");
+    }
+    if (!ascend_syms.dvpp_lib) {
+        av_log(log_ctx, AV_LOG_ERROR, "[Ascend] libacl_dvpp.so not found\n");
+        return AVERROR_EXTERNAL;
+    }
+
+#define LOAD_GSYM(field, lib)                                                 \
+    do {                                                                      \
+        ascend_syms.field = (void *)dlsym(ascend_syms.lib, #field);           \
+        if (!ascend_syms.field) {                                             \
+            av_log(log_ctx, AV_LOG_ERROR, "[Ascend] missing symbol %s\n",    \
+                   #field);                                                   \
+            return AVERROR_EXTERNAL;                                          \
+        }                                                                     \
+    } while (0)
+
+    LOAD_GSYM(aclInit, acl_lib);
+    LOAD_GSYM(aclFinalize, acl_lib);
+    LOAD_GSYM(aclrtSetDevice, acl_lib);
+    LOAD_GSYM(aclrtResetDevice, acl_lib);
+    LOAD_GSYM(aclrtCreateContext, acl_lib);
+    LOAD_GSYM(aclrtDestroyContext, acl_lib);
+    LOAD_GSYM(aclrtSetCurrentContext, acl_lib);
+    LOAD_GSYM(aclrtCreateStream, acl_lib);
+    LOAD_GSYM(aclrtDestroyStream, acl_lib);
+    LOAD_GSYM(aclrtSynchronizeStream, acl_lib);
+    LOAD_GSYM(aclrtMallocHost, acl_lib);
+    LOAD_GSYM(aclrtFreeHost, acl_lib);
+    LOAD_GSYM(aclrtMemcpy, acl_lib);
+    LOAD_GSYM(acldvppMalloc, dvpp_lib);
+    LOAD_GSYM(acldvppFree, dvpp_lib);
+#undef LOAD_GSYM
+
+    return 0;
+}
+
+static void ascend_cleanup_unlocked(void)
+{
+    for (int i = 0; i < (int)FF_ARRAY_ELEMS(ascend_device_refs); i++) {
+        if (ascend_device_contexts[i] && ascend_syms.aclrtDestroyContext) {
+            ascend_syms.aclrtDestroyContext(ascend_device_contexts[i]);
+            ascend_device_contexts[i] = NULL;
+        }
+        if (ascend_device_refs[i] > 0 && ascend_syms.aclrtResetDevice) {
+            ascend_syms.aclrtResetDevice(i);
+            ascend_device_refs[i] = 0;
+        }
+    }
+    if (ascend_acl_refs > 0) {
+        ascend_acl_refs = 0;
+        if (ascend_syms.aclFinalize)
+            ascend_syms.aclFinalize();
+    }
+}
+
+static void ascend_atexit_cleanup(void)
+{
+    pthread_mutex_lock(&ascend_global_lock);
+    ascend_cleanup_unlocked();
+    pthread_mutex_unlock(&ascend_global_lock);
+}
+
+static void ascend_signal_handler(int sig)
+{
+    if (pthread_mutex_trylock(&ascend_global_lock) == 0) {
+        ascend_cleanup_unlocked();
+        pthread_mutex_unlock(&ascend_global_lock);
+    }
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+int av_ascend_global_acquire(int device_id, void **out_acl_lib,
+                             void **out_dvpp_lib, void **out_context,
+                             void *log_ctx)
+{
+    static int atexit_registered = 0;
+    aclrtContext ctx = NULL;
+    aclError ret;
+    int err;
+
+    if (device_id < 0 || device_id >= (int)FF_ARRAY_ELEMS(ascend_device_refs))
+        return AVERROR(EINVAL);
+
+    pthread_mutex_lock(&ascend_global_lock);
+    err = ensure_global_syms_locked(log_ctx);
+    if (err < 0) {
+        pthread_mutex_unlock(&ascend_global_lock);
+        return err;
+    }
+
+    if (!atexit_registered) {
+        static const int sigs[] = { SIGINT, SIGTERM, SIGHUP };
+        struct sigaction sa, old_sa;
+        atexit(ascend_atexit_cleanup);
+        memset(&sa, 0, sizeof(sa));
+        sa.sa_handler = ascend_signal_handler;
+        sigemptyset(&sa.sa_mask);
+        sa.sa_flags = SA_RESETHAND;
+        for (int i = 0; i < (int)FF_ARRAY_ELEMS(sigs); i++) {
+            if (sigaction(sigs[i], NULL, &old_sa) == 0 &&
+                old_sa.sa_handler == SIG_DFL)
+                sigaction(sigs[i], &sa, NULL);
+        }
+        atexit_registered = 1;
+    }
+
+    if (!ascend_acl_refs) {
+        ret = ascend_syms.aclInit(NULL);
+        if (ret != ACL_SUCCESS && ret != ACL_ERROR_REPEAT_INITIALIZE) {
+            pthread_mutex_unlock(&ascend_global_lock);
+            av_log(log_ctx, AV_LOG_ERROR, "[Ascend] aclInit failed: 0x%x\n", ret);
+            return AVERROR_EXTERNAL;
+        }
+    }
+    ascend_acl_refs++;
+
+    if (!ascend_device_refs[device_id]) {
+        ret = ascend_syms.aclrtSetDevice(device_id);
+        if (ret != ACL_SUCCESS) {
+            ascend_acl_refs--;
+            pthread_mutex_unlock(&ascend_global_lock);
+            av_log(log_ctx, AV_LOG_ERROR,
+                   "[Ascend] aclrtSetDevice(%d) failed: 0x%x\n", device_id, ret);
+            return AVERROR_EXTERNAL;
+        }
+
+        ret = ascend_syms.aclrtCreateContext(&ascend_device_contexts[device_id], device_id);
+        if (ret != ACL_SUCCESS || !ascend_device_contexts[device_id]) {
+            ascend_syms.aclrtResetDevice(device_id);
+            ascend_acl_refs--;
+            pthread_mutex_unlock(&ascend_global_lock);
+            av_log(log_ctx, AV_LOG_ERROR,
+                   "[Ascend] aclrtCreateContext failed: 0x%x\n", ret);
+            return AVERROR_EXTERNAL;
+        }
+    }
+    ascend_device_refs[device_id]++;
+    ctx = ascend_device_contexts[device_id];
+    pthread_mutex_unlock(&ascend_global_lock);
+
+    ascend_syms.aclrtSetCurrentContext(ctx);
+    if (out_acl_lib)
+        *out_acl_lib = ascend_syms.acl_lib;
+    if (out_dvpp_lib)
+        *out_dvpp_lib = ascend_syms.dvpp_lib;
+    if (out_context)
+        *out_context = ctx;
+    return 0;
+}
+
+void av_ascend_global_release(int device_id, void *context)
+{
+    pthread_mutex_lock(&ascend_global_lock);
+    if (device_id >= 0 && device_id < (int)FF_ARRAY_ELEMS(ascend_device_refs)) {
+        if (ascend_device_refs[device_id] > 0)
+            ascend_device_refs[device_id]--;
+        if (!ascend_device_refs[device_id]) {
+            if (ascend_device_contexts[device_id] && ascend_syms.aclrtDestroyContext) {
+                ascend_syms.aclrtDestroyContext(ascend_device_contexts[device_id]);
+                ascend_device_contexts[device_id] = NULL;
+            }
+            if (ascend_syms.aclrtResetDevice)
+                ascend_syms.aclrtResetDevice(device_id);
+        }
+    }
+    if (ascend_acl_refs > 0) {
+        ascend_acl_refs--;
+        if (!ascend_acl_refs) {
+            if (ascend_syms.aclFinalize)
+                ascend_syms.aclFinalize();
+        }
+    }
+    pthread_mutex_unlock(&ascend_global_lock);
+}
+
+typedef struct AscendDevicePriv {
+    AVAscendDeviceContext p;
+    int acquired;
+} AscendDevicePriv;
+
+typedef struct AscendFramesPriv {
+    uint32_t stride_w;
+    uint32_t stride_h;
+    size_t y_size;
+    size_t uv_size;
+    size_t total_size;
+} AscendFramesPriv;
+
+static const enum AVPixelFormat supported_sw_formats[] = {
+    AV_PIX_FMT_NV12,
+};
+
+static void ascend_device_uninit(AVHWDeviceContext *ctx)
+{
+    AscendDevicePriv *priv = ctx->hwctx;
+
+    if (!priv->acquired)
+        return;
+    if (priv->p.context && ascend_syms.aclrtSetCurrentContext)
+        ascend_syms.aclrtSetCurrentContext(priv->p.context);
+    if (priv->p.stream && ascend_syms.aclrtDestroyStream) {
+        ascend_syms.aclrtDestroyStream(priv->p.stream);
+        priv->p.stream = NULL;
+    }
+    av_ascend_global_release(priv->p.device_id, priv->p.context);
+    priv->p.context = NULL;
+    priv->acquired = 0;
+}
+
+static int ascend_device_create(AVHWDeviceContext *ctx, const char *device,
+                                AVDictionary *opts, int flags)
+{
+    AscendDevicePriv *priv = ctx->hwctx;
+    const AVDictionaryEntry *e;
+    int ret;
+
+    priv->p.device_id = 0;
+    if (device && device[0])
+        priv->p.device_id = strtol(device, NULL, 0);
+    else if ((e = av_dict_get(opts, "device_id", NULL, 0)) ||
+             (e = av_dict_get(opts, "device", NULL, 0)))
+        priv->p.device_id = strtol(e->value, NULL, 0);
+
+    ret = av_ascend_global_acquire(priv->p.device_id, &priv->p.acl_lib,
+                                   &priv->p.dvpp_lib, &priv->p.context, ctx);
+    if (ret < 0)
+        return ret;
+    priv->acquired = 1;
+
+    if (ascend_syms.aclrtCreateStream(&priv->p.stream) != ACL_SUCCESS) {
+        av_log(ctx, AV_LOG_ERROR, "[Ascend] aclrtCreateStream failed\n");
+        ascend_device_uninit(ctx);
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+static int ascend_frames_get_constraints(AVHWDeviceContext *ctx,
+                                         const void *hwconfig,
+                                         AVHWFramesConstraints *constraints)
+{
+    constraints->valid_sw_formats = av_malloc_array(2, sizeof(*constraints->valid_sw_formats));
+    if (!constraints->valid_sw_formats)
+        return AVERROR(ENOMEM);
+    constraints->valid_sw_formats[0] = AV_PIX_FMT_NV12;
+    constraints->valid_sw_formats[1] = AV_PIX_FMT_NONE;
+
+    constraints->valid_hw_formats = av_malloc_array(2, sizeof(*constraints->valid_hw_formats));
+    if (!constraints->valid_hw_formats)
+        return AVERROR(ENOMEM);
+    constraints->valid_hw_formats[0] = AV_PIX_FMT_ASCEND;
+    constraints->valid_hw_formats[1] = AV_PIX_FMT_NONE;
+
+    constraints->min_width  = 16;
+    constraints->min_height = 16;
+    constraints->max_width  = 8192;
+    constraints->max_height = 8192;
+    return 0;
+}
+
+static void ascend_dvpp_buf_free(void *opaque, uint8_t *data)
+{
+    aclError (*free_fn)(void *) = opaque;
+    if (data && free_fn)
+        free_fn(data);
+}
+
+static AVBufferRef *ascend_frames_pool_alloc(void *opaque, size_t size)
+{
+    AVHWFramesContext *ctx = opaque;
+    AVAscendDeviceContext *hwctx = ctx->device_ctx->hwctx;
+    void *dev = NULL;
+    AVBufferRef *ref;
+
+    if (hwctx->context && ascend_syms.aclrtSetCurrentContext)
+        ascend_syms.aclrtSetCurrentContext(hwctx->context);
+
+    if (ascend_syms.acldvppMalloc(&dev, size) != ACL_SUCCESS || !dev)
+        return NULL;
+
+    ref = av_buffer_create((uint8_t *)dev, size, ascend_dvpp_buf_free,
+                           ascend_syms.acldvppFree, 0);
+    if (!ref) {
+        ascend_syms.acldvppFree(dev);
+        return NULL;
+    }
+    return ref;
+}
+
+static void ascend_frames_uninit(AVHWFramesContext *ctx)
+{
+}
+
+static int ascend_frames_init(AVHWFramesContext *ctx)
+{
+    AscendFramesPriv *priv = ctx->hwctx;
+
+    if (ctx->sw_format != AV_PIX_FMT_NV12) {
+        av_log(ctx, AV_LOG_ERROR,
+               "[Ascend] unsupported sw_format %s (only nv12 is supported)\n",
+               av_get_pix_fmt_name(ctx->sw_format));
+        return AVERROR(ENOSYS);
+    }
+
+    priv->stride_w   = FFALIGN(FFMAX(ctx->width, 16), ASCEND_ALIGN_W);
+    priv->stride_h   = FFALIGN(FFMAX(ctx->height, 16), ASCEND_ALIGN_H);
+    priv->y_size     = (size_t)priv->stride_w * priv->stride_h;
+    priv->uv_size    = (size_t)priv->stride_w * (priv->stride_h / 2);
+    priv->total_size = priv->y_size + priv->uv_size;
+
+    if (!ctx->pool) {
+        ffhwframesctx(ctx)->pool_internal =
+            av_buffer_pool_init2(priv->total_size, ctx,
+                                 ascend_frames_pool_alloc, NULL);
+        if (!ffhwframesctx(ctx)->pool_internal)
+            return AVERROR(ENOMEM);
+    }
+    return 0;
+}
+
+static int ascend_get_buffer(AVHWFramesContext *ctx, AVFrame *frame)
+{
+    AscendFramesPriv *priv = ctx->hwctx;
+
+    frame->buf[0] = av_buffer_pool_get(ctx->pool);
+    if (!frame->buf[0])
+        return AVERROR(ENOMEM);
+
+    frame->data[0]     = frame->buf[0]->data;
+    frame->linesize[0] = (int)priv->stride_w;
+    frame->data[1]     = frame->buf[0]->data + priv->y_size;
+    frame->linesize[1] = (int)priv->stride_w;
+    frame->format      = AV_PIX_FMT_ASCEND;
+    frame->width       = ctx->width;
+    frame->height      = ctx->height;
+    return 0;
+}
+
+static int ascend_transfer_get_formats(AVHWFramesContext *ctx,
+                                       enum AVHWFrameTransferDirection dir,
+                                       enum AVPixelFormat **formats)
+{
+    enum AVPixelFormat *fmts = av_malloc_array(2, sizeof(*fmts));
+    if (!fmts)
+        return AVERROR(ENOMEM);
+    fmts[0] = ctx->sw_format;
+    fmts[1] = AV_PIX_FMT_NONE;
+    *formats = fmts;
+    return 0;
+}
+
+static int ascend_transfer_data_from(AVHWFramesContext *ctx, AVFrame *dst,
+                                     const AVFrame *src)
+{
+    AVAscendDeviceContext *hwctx = ctx->device_ctx->hwctx;
+    AscendFramesPriv *priv = ctx->hwctx;
+    const uint8_t *dev_y = src->data[0];
+    const uint8_t *dev_uv = src->data[1];
+    uint32_t stride_w = src->linesize[0] > 0 ? (uint32_t)src->linesize[0] : priv->stride_w;
+    size_t y_size = (dev_uv && dev_y && dev_uv > dev_y)
+                    ? (size_t)(dev_uv - dev_y)
+                    : (size_t)stride_w * FFALIGN(src->height, ASCEND_ALIGN_H);
+    int width = FFMIN(src->width, dst->width);
+    int height = FFMIN(src->height, dst->height);
+    int chroma_h = (height + 1) / 2;
+    size_t uv_size = (size_t)stride_w * chroma_h;
+    int copy_w_y = FFMIN(width, dst->linesize[0]);
+    int copy_w_uv = FFMIN(width, dst->linesize[1]);
+    uint8_t *local_buf;
+
+    if (dst->format != AV_PIX_FMT_NV12)
+        return AVERROR(ENOSYS);
+
+    if (hwctx->context && ascend_syms.aclrtSetCurrentContext)
+        ascend_syms.aclrtSetCurrentContext(hwctx->context);
+
+    if (dst->linesize[0] == (int)stride_w && copy_w_y == (int)stride_w &&
+        dst->linesize[1] == (int)stride_w && copy_w_uv == (int)stride_w) {
+        size_t y_copy = (size_t)stride_w * height;
+        if (ascend_syms.aclrtMemcpy(dst->data[0], y_copy, dev_y, y_copy,
+                                    ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS ||
+            ascend_syms.aclrtMemcpy(dst->data[1], uv_size, dev_uv, uv_size,
+                                    ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS)
+            return AVERROR_EXTERNAL;
+        return 0;
+    }
+
+    /* Thread-safe local stage buffer to avoid cross-thread races */
+    local_buf = av_malloc(y_size + uv_size);
+    if (!local_buf)
+        return AVERROR(ENOMEM);
+
+    if (ascend_syms.aclrtMemcpy(local_buf, y_size + uv_size,
+                                dev_y, y_size + uv_size,
+                                ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
+        av_free(local_buf);
+        return AVERROR_EXTERNAL;
+    }
+
+    av_image_copy_plane(dst->data[0], dst->linesize[0],
+                        local_buf, stride_w,
+                        copy_w_y, height);
+    av_image_copy_plane(dst->data[1], dst->linesize[1],
+                        local_buf + y_size, stride_w,
+                        copy_w_uv, chroma_h);
+    av_free(local_buf);
+    return 0;
+}
+
+static int ascend_transfer_data_to(AVHWFramesContext *ctx, AVFrame *dst,
+                                   const AVFrame *src)
+{
+    AVAscendDeviceContext *hwctx = ctx->device_ctx->hwctx;
+    AscendFramesPriv *priv = ctx->hwctx;
+    uint8_t *dev_y = dst->data[0];
+    uint8_t *dev_uv = dst->data[1];
+    uint32_t stride_w = dst->linesize[0] > 0 ? (uint32_t)dst->linesize[0] : priv->stride_w;
+    size_t y_size = (dev_uv && dev_y && dev_uv > dev_y)
+                    ? (size_t)(dev_uv - dev_y)
+                    : priv->y_size;
+    int width = FFMIN(src->width, dst->width);
+    int height = FFMIN(src->height, dst->height);
+    int chroma_h = (height + 1) / 2;
+    size_t uv_size = (size_t)stride_w * chroma_h;
+    int copy_w_y = FFMIN(width, src->linesize[0]);
+    int copy_w_uv = FFMIN(width, src->linesize[1]);
+    uint8_t *local_buf;
+
+    if (src->format != AV_PIX_FMT_NV12)
+        return AVERROR(ENOSYS);
+
+    if (hwctx->context && ascend_syms.aclrtSetCurrentContext)
+        ascend_syms.aclrtSetCurrentContext(hwctx->context);
+
+    if (src->linesize[0] == (int)stride_w && copy_w_y == (int)stride_w &&
+        src->linesize[1] == (int)stride_w && copy_w_uv == (int)stride_w) {
+        size_t y_copy = (size_t)stride_w * height;
+        if (ascend_syms.aclrtMemcpy(dev_y, y_copy, src->data[0], y_copy,
+                                    ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
+            ascend_syms.aclrtMemcpy(dev_uv, uv_size, src->data[1], uv_size,
+                                    ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS)
+            return AVERROR_EXTERNAL;
+        return 0;
+    }
+
+    local_buf = av_malloc(y_size + uv_size);
+    if (!local_buf)
+        return AVERROR(ENOMEM);
+
+    av_image_copy_plane(local_buf, stride_w,
+                        src->data[0], src->linesize[0],
+                        copy_w_y, height);
+    av_image_copy_plane(local_buf + y_size, stride_w,
+                        src->data[1], src->linesize[1],
+                        copy_w_uv, chroma_h);
+
+    if (ascend_syms.aclrtMemcpy(dev_y, y_size + uv_size,
+                                local_buf, y_size + uv_size,
+                                ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
+        av_free(local_buf);
+        return AVERROR_EXTERNAL;
+    }
+
+    av_free(local_buf);
+    return 0;
+}
+
+const HWContextType ff_hwcontext_type_ascend = {
+    .type                   = AV_HWDEVICE_TYPE_ASCEND,
+    .name                   = "ascend",
+    .device_hwctx_size      = sizeof(AscendDevicePriv),
+    .frames_hwctx_size      = sizeof(AscendFramesPriv),
+    .device_create          = ascend_device_create,
+    .device_uninit          = ascend_device_uninit,
+    .frames_get_constraints = ascend_frames_get_constraints,
+    .frames_init            = ascend_frames_init,
+    .frames_uninit          = ascend_frames_uninit,
+    .frames_get_buffer      = ascend_get_buffer,
+    .transfer_get_formats   = ascend_transfer_get_formats,
+    .transfer_data_to       = ascend_transfer_data_to,
+    .transfer_data_from     = ascend_transfer_data_from,
+    .pix_fmts = (const enum AVPixelFormat[]) {
+        AV_PIX_FMT_ASCEND,
+        AV_PIX_FMT_NONE
+    },
+};
+
+#else /* _WIN32 */
+
+int av_ascend_global_acquire(int device_id, void **out_acl_lib,
+                             void **out_dvpp_lib, void **out_context,
+                             void *log_ctx)
+{
+    return AVERROR(ENOSYS);
+}
+
+void av_ascend_global_release(int device_id, void *context)
+{
+}
