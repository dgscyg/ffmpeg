+    int in_pool_count;
+
+    AscendInBuf in_active[ASCEND_ACTIVE_SLOTS];
+    int in_active_count;
+    void *out_active[ASCEND_ACTIVE_SLOTS];
+    int out_active_count;
+
+    /* libascendcl.so */
+    aclError (*aclrtSetCurrentContext)(aclrtContext);
+    aclError (*aclrtMallocHost)(void **, size_t);
+    aclError (*aclrtFreeHost)(void *);
+    aclError (*aclrtMemcpy)(void *, size_t, const void *, size_t, aclrtMemcpyKind);
+} AscendDecodeContext;
+
+static void *get_dyn_sym(void *h, const char *name)
+{
+    return h ? dlsym(h, name) : NULL;
+}
+
+static void *load_mpi_lib(void)
+{
+    void *h = dlopen("libacl_dvpp_mpi.so", RTLD_NOW | RTLD_GLOBAL);
+    const char *paths[] = {
+        "/usr/local/Ascend/ascend-toolkit/latest/lib64",
+        "/usr/local/Ascend/ascend-toolkit/latest/aarch64-linux/lib64",
+        "/usr/local/Ascend/ascend-toolkit/latest/x86_64-linux/lib64",
+        "/usr/local/Ascend/ascend-toolkit/latest/runtime/lib64",
+        "/usr/local/Ascend/nnae/latest/lib64",
+        "/usr/local/Ascend/ascend-toolkit/lib64",
+        NULL
+    };
+    char buf[512];
+
+    if (h)
+        return h;
+    for (int i = 0; paths[i]; i++) {
+        snprintf(buf, sizeof(buf), "%s/libacl_dvpp_mpi.so", paths[i]);
+        h = dlopen(buf, RTLD_NOW | RTLD_GLOBAL);
+        if (h)
+            return h;
+    }
+    return NULL;
+}
+
+static int ensure_mpi_ready(AVCodecContext *avctx)
+{
+    int ret = 0;
+
+    pthread_mutex_lock(&ascend_v2_lock);
+    if (!ascend_mpi.mpi_lib) {
+        ascend_mpi.mpi_lib = load_mpi_lib();
+        if (!ascend_mpi.mpi_lib) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "[Ascend] libacl_dvpp_mpi.so not found (DVPP V2 required)\n");
+            ret = AVERROR_EXTERNAL;
+            goto out;
+        }
+
+#define LOAD_MPI(field)                                                      \
+        do {                                                                 \
+            ascend_mpi.field = (void *)dlsym(ascend_mpi.mpi_lib, #field);    \
+            if (!ascend_mpi.field) {                                         \
+                av_log(avctx, AV_LOG_ERROR,                                  \
+                       "[Ascend] missing DVPP V2 symbol %s\n", #field);      \
+                ret = AVERROR_EXTERNAL;                                      \
+                goto out;                                                    \
+            }                                                                \
+        } while (0)
+
+        LOAD_MPI(hi_mpi_sys_init);
+        LOAD_MPI(hi_mpi_dvpp_malloc);
+        LOAD_MPI(hi_mpi_dvpp_free);
+        LOAD_MPI(hi_mpi_vdec_create_chn);
+        LOAD_MPI(hi_mpi_vdec_destroy_chn);
+        LOAD_MPI(hi_mpi_vdec_start_recv_stream);
+        LOAD_MPI(hi_mpi_vdec_stop_recv_stream);
+        LOAD_MPI(hi_mpi_vdec_send_stream);
+        LOAD_MPI(hi_mpi_vdec_get_frame);
+        LOAD_MPI(hi_mpi_vdec_release_frame);
+#undef LOAD_MPI
+        ascend_mpi.hi_mpi_vdec_reset_chn =
+            (void *)dlsym(ascend_mpi.mpi_lib, "hi_mpi_vdec_reset_chn");
+    }
+
+    if (!ascend_mpi.sys_inited) {
+        ff_hi_s32 rc = ascend_mpi.hi_mpi_sys_init();
+        if (rc != 0 && (ff_hi_u32)rc != FF_HI_ERR_SYS_EXIST) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "[Ascend] hi_mpi_sys_init failed: 0x%x\n", (unsigned)rc);
+            ret = AVERROR_EXTERNAL;
+            goto out;
+        }
+        ascend_mpi.sys_inited = 1;
+    }
+
+out:
+    pthread_mutex_unlock(&ascend_v2_lock);
+    return ret;
+}
+
+static int chn_bitmap_try_claim(int ch)
+{
+    int word, ok = 0;
+    uint64_t mask;
+
+    if (ch < 0 || ch >= FF_HI_VDEC_MAX_CHN_NUM)
+        return 0;
+    word = ch >> 6;
+    mask = 1ULL << (ch & 63);
+    pthread_mutex_lock(&ascend_v2_lock);
+    if (!(ascend_chn_bitmap[word] & mask)) {
+        ascend_chn_bitmap[word] |= mask;
+        ok = 1;
+    }
+    pthread_mutex_unlock(&ascend_v2_lock);
+    return ok;
+}
+
+static void chn_bitmap_release(int ch)
+{
+    int word;
+    uint64_t mask;
+
+    if (ch < 0 || ch >= FF_HI_VDEC_MAX_CHN_NUM)
+        return;
+    word = ch >> 6;
+    mask = 1ULL << (ch & 63);
+    pthread_mutex_lock(&ascend_v2_lock);
+    ascend_chn_bitmap[word] &= ~mask;
+    pthread_mutex_unlock(&ascend_v2_lock);
+}
+
+static int chn_bitmap_claim_any(int preferred)
+{
+    if (preferred >= 0 && preferred < FF_HI_VDEC_MAX_CHN_NUM &&
+        chn_bitmap_try_claim(preferred))
+        return preferred;
+
+    pthread_mutex_lock(&ascend_v2_lock);
+    for (int i = 0; i < FF_HI_VDEC_MAX_CHN_NUM; i++) {
+        int ch = (int)((ascend_chn_cursor + (uint32_t)i) % FF_HI_VDEC_MAX_CHN_NUM);
+        int word = ch >> 6;
+        uint64_t mask = 1ULL << (ch & 63);
+        if (!(ascend_chn_bitmap[word] & mask)) {
+            ascend_chn_bitmap[word] |= mask;
+            ascend_chn_cursor = (uint32_t)((ch + 1) % FF_HI_VDEC_MAX_CHN_NUM);
+            pthread_mutex_unlock(&ascend_v2_lock);
+            return ch;
+        }
+    }
+    pthread_mutex_unlock(&ascend_v2_lock);
+    return -1;
+}
+
+static AscendOutPool *out_pool_alloc(AscendContextRef *cref, int max_bufs)
+{
+    AscendOutPool *p;
+    if (!cref)
+        return NULL;
+    p = av_mallocz(sizeof(*p));
+    if (!p)
+        return NULL;
+    atomic_init(&p->refs, 1);
+    pthread_mutex_init(&p->lock, NULL);
+    pthread_cond_init(&p->cond, NULL);
+    p->max_bufs = FFMAX(4, FFMIN(max_bufs, ASCEND_OUT_POOL_SIZE));
+    atomic_fetch_add(&cref->refs, 1);
+    p->cref = cref;
+    return p;
+}
+
+static void ascend_cref_unref(AscendContextRef *cref)
+{
+    if (cref && atomic_fetch_sub(&cref->refs, 1) == 1) {
+        av_ascend_global_release(cref->device_id, cref->context);
+        av_free(cref);
+    }
+}
+
+static void out_pool_unref(AscendOutPool *p)
+{
+    if (!p)
+        return;
+    if (atomic_fetch_sub(&p->refs, 1) == 1) {
+        AscendContextRef *cref = p->cref;
+        if (cref && cref->context && cref->aclrtSetCurrentContext)
+            cref->aclrtSetCurrentContext(cref->context);
+        for (int i = 0; i < p->count; i++) {
+            if (p->bufs[i] && cref && cref->hi_mpi_dvpp_free)
+                cref->hi_mpi_dvpp_free(p->bufs[i]);
+        }
+        pthread_cond_destroy(&p->cond);
+        pthread_mutex_destroy(&p->lock);
+        av_free(p);
+        ascend_cref_unref(cref);
+    }
+}
+
+static void out_pool_put_raw(AscendOutPool *p, void *dev)
+{
+    if (!p || !dev)
+        return;
+    pthread_mutex_lock(&p->lock);
+    if (!p->closed && p->count < p->max_bufs && p->allocated <= p->max_bufs) {
+        p->bufs[p->count++] = dev;
+        pthread_cond_signal(&p->cond);
+        pthread_mutex_unlock(&p->lock);
+        return;
+    }
+    if (p->allocated > 0)
+        p->allocated--;
+    pthread_cond_broadcast(&p->cond);
+    pthread_mutex_unlock(&p->lock);
+    if (p->cref && p->cref->hi_mpi_dvpp_free) {
+        if (p->cref->context && p->cref->aclrtSetCurrentContext)
+            p->cref->aclrtSetCurrentContext(p->cref->context);
+        p->cref->hi_mpi_dvpp_free(dev);
+    }
+}
+
+static void out_pool_put(AscendDecodeContext *ctx, void *dev)
+{
+    out_pool_put_raw(ctx->out_pool, dev);
+}
+
+static int out_pool_at_cap(AscendDecodeContext *ctx)
+{
+    AscendOutPool *p = ctx->out_pool;
+    int at_cap = 0;
+
+    if (!p)
+        return 0;
+    pthread_mutex_lock(&p->lock);
+    at_cap = (p->count == 0 && p->allocated >= p->max_bufs);
+    pthread_mutex_unlock(&p->lock);
+    return at_cap;
+}
+
+static void out_pool_clear(AscendDecodeContext *ctx, int mark_closed)
+{
+    AscendOutPool *p = ctx->out_pool;
+    if (!p)
+        return;
+    pthread_mutex_lock(&p->lock);
+    if (mark_closed)
+        p->closed = 1;
+    if (p->cref && p->cref->context && p->cref->aclrtSetCurrentContext)
+        p->cref->aclrtSetCurrentContext(p->cref->context);
+    while (p->count > 0) {
+        void *dev = p->bufs[--p->count];
+        if (p->allocated > 0)
+            p->allocated--;
+        if (dev && p->cref && p->cref->hi_mpi_dvpp_free)
+            p->cref->hi_mpi_dvpp_free(dev);
+    }
+    p->buf_size = 0;
+    pthread_cond_broadcast(&p->cond);
+    pthread_mutex_unlock(&p->lock);
+}
+
+static void *out_pool_get(AscendDecodeContext *ctx, size_t size)
+{
+    AscendOutPool *p = ctx->out_pool;
+    void *dev = NULL;
+
+    if (!p)
+        return NULL;
+    pthread_mutex_lock(&p->lock);
+    if (p->buf_size != size) {
+        while (p->count > 0) {
+            void *old = p->bufs[--p->count];
+            if (p->allocated > 0)
+                p->allocated--;
+            if (old && p->cref && p->cref->hi_mpi_dvpp_free)
+                p->cref->hi_mpi_dvpp_free(old);
+        }
+        p->buf_size = size;
+    }
+    if (p->count == 0 && !p->closed && p->allocated >= p->max_bufs) {
+        struct timespec ts;
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_nsec += 50 * 1000000L;
+        if (ts.tv_nsec >= 1000000000L) {
+            ts.tv_sec++;
+            ts.tv_nsec -= 1000000000L;
+        }
+        while (p->count == 0 && !p->closed && p->allocated >= p->max_bufs) {
+            if (pthread_cond_timedwait(&p->cond, &p->lock, &ts) != 0)
+                break;
+        }
+    }
+    if (p->count > 0) {
+        dev = p->bufs[--p->count];
+        pthread_mutex_unlock(&p->lock);
+        return dev;
+    }
+    p->allocated++;
+    pthread_mutex_unlock(&p->lock);
+
+    if (ascend_mpi.hi_mpi_dvpp_malloc((ff_hi_u32)ctx->device_id, &dev,
+                                      (ff_hi_u64)size) != 0 || !dev) {
+        pthread_mutex_lock(&p->lock);
+        if (p->allocated > 0)
+            p->allocated--;
+        pthread_mutex_unlock(&p->lock);
+        return NULL;
+    }
+    return dev;
+}
+
+static void ascend_dev_frame_free(void *opaque, uint8_t *data)
+{
+    AscendOutPool *p = opaque;
+    if (data)
+        out_pool_put_raw(p, data);
+    out_pool_unref(p);
+}
+
+static int in_pool_get(AscendDecodeContext *ctx, size_t need_size,
+                       void **out_ptr, size_t *out_cap)
+{
+    void *stale_ptr = NULL;
+    size_t alloc_size;
+
+    for (int i = ctx->in_pool_count - 1; i >= 0; i--) {
+        if (ctx->in_pool[i].cap >= need_size) {
+            *out_ptr = ctx->in_pool[i].ptr;
+            *out_cap = ctx->in_pool[i].cap;
+            ctx->in_pool[i] = ctx->in_pool[--ctx->in_pool_count];
+            return 0;
+        }
+    }
+    if (ctx->in_pool_count > 0)
+        stale_ptr = ctx->in_pool[--ctx->in_pool_count].ptr;
+
+    if (stale_ptr && ascend_mpi.hi_mpi_dvpp_free)
+        ascend_mpi.hi_mpi_dvpp_free(stale_ptr);
+
+    alloc_size = FFALIGN(FFMAX(need_size, (size_t)ASCEND_IN_MIN_ALLOC),
+                         (size_t)(128 * 1024));
+    if (ascend_mpi.hi_mpi_dvpp_malloc((ff_hi_u32)ctx->device_id, out_ptr,
+                                      (ff_hi_u64)alloc_size) != 0 || !*out_ptr)
+        return AVERROR(ENOMEM);
+    *out_cap = alloc_size;
+    return 0;
+}
+
+static void in_pool_put(AscendDecodeContext *ctx, void *ptr, size_t cap)
+{
+    if (!ptr)
+        return;
+    if (cap > 0 && ctx->in_pool_count < ASCEND_IN_POOL_SIZE) {
+        ctx->in_pool[ctx->in_pool_count].ptr = ptr;
+        ctx->in_pool[ctx->in_pool_count].cap = cap;
+        ctx->in_pool_count++;
+        return;
+    }
+    if (ascend_mpi.hi_mpi_dvpp_free)
+        ascend_mpi.hi_mpi_dvpp_free(ptr);
+}
+
+static void in_pool_clear(AscendDecodeContext *ctx)
+{
+    while (ctx->in_pool_count > 0) {
+        void *ptr = ctx->in_pool[--ctx->in_pool_count].ptr;
+        if (ptr && ascend_mpi.hi_mpi_dvpp_free)
+            ascend_mpi.hi_mpi_dvpp_free(ptr);
+    }
+}
+
+static void active_track_push(AscendDecodeContext *ctx, void *in_dev,
+                              size_t in_cap, void *out_dev)
+{
+    if (in_dev && ctx->in_active_count < ASCEND_ACTIVE_SLOTS) {
+        ctx->in_active[ctx->in_active_count].ptr = in_dev;
+        ctx->in_active[ctx->in_active_count].cap = in_cap;
+        ctx->in_active_count++;
+    }
+    if (out_dev && ctx->out_active_count < ASCEND_ACTIVE_SLOTS)
+        ctx->out_active[ctx->out_active_count++] = out_dev;
+}
+
+static void active_reclaim_in(AscendDecodeContext *ctx, void *in_dev)
+{
+    size_t cap = 0;
+
+    if (!in_dev)
+        return;
+    for (int i = 0; i < ctx->in_active_count; i++) {
+        if (ctx->in_active[i].ptr == in_dev) {
+            cap = ctx->in_active[i].cap;
+            ctx->in_active[i] = ctx->in_active[--ctx->in_active_count];
+            break;
+        }
+    }
+    in_pool_put(ctx, in_dev, cap);
+}
+
+static void active_remove_out(AscendDecodeContext *ctx, void *out_dev)
+{
+    if (!out_dev)
+        return;
+    for (int i = 0; i < ctx->out_active_count; i++) {
+        if (ctx->out_active[i] == out_dev) {
+            ctx->out_active[i] = ctx->out_active[--ctx->out_active_count];
+            return;
+        }
+    }
+}
+
+static void active_reclaim_all(AscendDecodeContext *ctx)
+{
+    while (ctx->in_active_count > 0) {
+        AscendInBuf b = ctx->in_active[--ctx->in_active_count];
+        in_pool_put(ctx, b.ptr, b.cap);
+    }
+    while (ctx->out_active_count > 0) {
+        void *dev = ctx->out_active[--ctx->out_active_count];
+        out_pool_put(ctx, dev);
+    }
+    ctx->in_flight = 0;
+}
+
+static void ascend_host_buf_free(void *opaque, uint8_t *data)
+{
+    (void)opaque;
+    if (data)
+        av_ascend_free_host(data);
+}
+
+static AVBufferRef *ascend_host_pool_alloc(void *opaque, size_t size)
+{
+    AscendDecodeContext *ctx = opaque;
+    void *ptr = NULL;
+    AVBufferRef *ref;
+
+    if (ctx && ctx->aclrtMallocHost) {
+        if (ctx->context && ctx->aclrtSetCurrentContext)
+            ctx->aclrtSetCurrentContext(ctx->context);
+        if (ctx->aclrtMallocHost(&ptr, size) == ACL_SUCCESS && ptr) {
+            ref = av_buffer_create((uint8_t *)ptr, size, ascend_host_buf_free,
+                                   NULL, 0);
+            if (!ref) {
+                ctx->aclrtFreeHost(ptr);
+                return NULL;
+            }
+            return ref;
+        }
+        if (ctx->cref && !ctx->cref->host_alloc_warned) {
+            ctx->cref->host_alloc_warned = 1;
+            av_log(NULL, AV_LOG_WARNING,
+                   "[Ascend] aclrtMallocHost(%zu) failed, falling back to pageable host memory\n",
+                   size);
+        }
+    }
+    return av_buffer_alloc(size);
+}
+
+static int ascend_ensure_host_pool(AscendDecodeContext *ctx, size_t need_size)
+{
+    if (ctx->host_frame_pool && ctx->host_frame_size >= need_size)
+        return 0;
+    av_buffer_pool_uninit(&ctx->host_frame_pool);
+    ctx->host_frame_size = 0;
+    ctx->host_frame_pool = av_buffer_pool_init2(need_size, ctx,
+                                                ascend_host_pool_alloc, NULL);
+    if (!ctx->host_frame_pool)
+        return AVERROR(ENOMEM);
+    ctx->host_frame_size = need_size;
+    return 0;
+}
+
+static void ascend_free_host_pool(AscendDecodeContext *ctx)
+{
+    av_buffer_pool_uninit(&ctx->host_frame_pool);
+    ctx->host_frame_size = 0;
+}
+
+static int load_acl_symbols(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    void *acl = ctx->acl_lib;
+
+#define LOAD_SYM(field)                                                   \
+    do {                                                                  \
+        ctx->field = (void *)get_dyn_sym(acl, #field);                    \
+        if (!ctx->field) {                                                \
+            av_log(avctx, AV_LOG_ERROR, "[Ascend] missing symbol %s\n",   \
+                   #field);                                               \
+            return AVERROR_EXTERNAL;                                      \
+        }                                                                 \
+    } while (0)
+
+    LOAD_SYM(aclrtSetCurrentContext);
+    LOAD_SYM(aclrtMallocHost);
+    LOAD_SYM(aclrtFreeHost);
+    LOAD_SYM(aclrtMemcpy);
+#undef LOAD_SYM
+    return 0;
+}
+
+static void get_dimensions(AVCodecContext *avctx, int *width, int *height,
+                           int *coded_w, int *coded_h)
+{
+    *coded_w = avctx->coded_width  > 0 ? avctx->coded_width  : avctx->width;
+    *coded_h = avctx->coded_height > 0 ? avctx->coded_height : avctx->height;
+    *width   = avctx->width        > 0 ? avctx->width        : *coded_w;
+    *height  = avctx->height       > 0 ? avctx->height       : *coded_h;
+    if (*coded_w <= 0)
+        *coded_w = *width > 0 ? *width : 1920;
+    if (*coded_h <= 0)
+        *coded_h = *height > 0 ? *height : 1080;
+    if (*width <= 0)
+        *width = *coded_w;
+    if (*height <= 0)
+        *height = *coded_h;
+}
+
+static void ascend_destroy_channel(AscendDecodeContext *ctx)
+{
+    if (!ctx->channel_created)
+        return;
+    if (ascend_mpi.hi_mpi_vdec_stop_recv_stream)
+        ascend_mpi.hi_mpi_vdec_stop_recv_stream(ctx->active_chn);
+    if (ascend_mpi.hi_mpi_vdec_destroy_chn)
+        ascend_mpi.hi_mpi_vdec_destroy_chn(ctx->active_chn);
+    chn_bitmap_release(ctx->active_chn);
+    ctx->channel_created = 0;
+    ctx->active_chn = -1;
+    ctx->channel_width = 0;
+    ctx->channel_height = 0;
+    active_reclaim_all(ctx);
+}
+
+static int ascend_ensure_hw_frames(AVCodecContext *avctx, int width, int height)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    AVHWFramesContext *frames_ctx;
+    int ret;
+
+    if (avctx->hw_frames_ctx) {
+        frames_ctx = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+        if (frames_ctx->width == width && frames_ctx->height == height)
+            return 0;
+        av_buffer_unref(&avctx->hw_frames_ctx);
+    }
+
+    if (!ctx->hw_device_ref) {
+        if (avctx->hw_device_ctx) {
+            ctx->hw_device_ref = av_buffer_ref(avctx->hw_device_ctx);
+        } else {
+            char dev_str[16];
+            snprintf(dev_str, sizeof(dev_str), "%d", ctx->device_id);
+            ret = av_hwdevice_ctx_create(&ctx->hw_device_ref,
+                                         AV_HWDEVICE_TYPE_ASCEND,
+                                         dev_str, NULL, 0);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    av_buffer_unref(&ctx->hw_frames_ref);
+    ctx->hw_frames_ref = av_hwframe_ctx_alloc(ctx->hw_device_ref);
+    if (!ctx->hw_frames_ref)
+        return AVERROR(ENOMEM);
+
+    frames_ctx            = (AVHWFramesContext *)ctx->hw_frames_ref->data;
+    frames_ctx->format    = AV_PIX_FMT_ASCEND;
+    frames_ctx->sw_format = AV_PIX_FMT_NV12;
+    frames_ctx->width     = width;
+    frames_ctx->height    = height;
+
+    ret = av_hwframe_ctx_init(ctx->hw_frames_ref);
+    if (ret < 0) {
+        av_buffer_unref(&ctx->hw_frames_ref);
+        return ret;
+    }
+
+    avctx->hw_frames_ctx = av_buffer_ref(ctx->hw_frames_ref);
+    return avctx->hw_frames_ctx ? 0 : AVERROR(ENOMEM);
+}
+
+static int ascend_create_channel(AVCodecContext *avctx, int coded_w, int coded_h)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    uint32_t stride_w = FFALIGN(coded_w, ASCEND_ALIGN_WIDTH);
+    uint32_t stride_h = FFALIGN(coded_h, ASCEND_ALIGN_HEIGHT);
+    uint32_t stream_buf_sz = FFMAX(stride_w * stride_h * 3u / 2u, 1024u * 1024u);
+    uint32_t ref_num = (avctx->refs > 0 && avctx->refs <= 16)
+                       ? (uint32_t)avctx->refs : 4u;
+    ff_hi_vdec_chn_attr attr;
+    ff_hi_s32 rc = -1;
+    int preferred = (ctx->channel_id >= 0 && ctx->channel_id < FF_HI_VDEC_MAX_CHN_NUM)
+                    ? ctx->channel_id : -1;
+    int external_busy[FF_HI_VDEC_MAX_CHN_NUM];
+    int external_busy_cnt = 0;
+
+    memset(&attr, 0, sizeof(attr));
+    attr.type            = (avctx->codec_id == AV_CODEC_ID_HEVC) ? FF_HI_PT_H265 : FF_HI_PT_H264;
+    attr.mode            = FF_HI_VDEC_SEND_MODE_FRAME;
+    attr.pic_width       = (ff_hi_u32)coded_w;
+    attr.pic_height      = (ff_hi_u32)coded_h;
+    attr.stream_buf_size = stream_buf_sz;
+    attr.frame_buf_size  = 0;
+    attr.frame_buf_cnt   = 0;
+    attr.video_attr.ref_frame_num   = ref_num;
+    attr.video_attr.temporal_mvp_en = 0;
+    attr.video_attr.tmv_buf_size    = 0;
+
+    for (int attempt = 0; attempt < FF_HI_VDEC_MAX_CHN_NUM; attempt++) {
+        int ch = chn_bitmap_claim_any(attempt == 0 ? preferred : -1);
+        if (ch < 0)
+            break;
+
+        rc = ascend_mpi.hi_mpi_vdec_create_chn(ch, &attr);
+        if (rc == 0) {
+            ff_hi_s32 src = ascend_mpi.hi_mpi_vdec_start_recv_stream(ch);
+            if (src == 0) {
+                ctx->active_chn = ch;
+                ctx->channel_created = 1;
+                break;
+            }
+            ascend_mpi.hi_mpi_vdec_destroy_chn(ch);
+            chn_bitmap_release(ch);
+            av_log(avctx, AV_LOG_ERROR,
+                   "[Ascend] hi_mpi_vdec_start_recv_stream(ch=%d) failed: 0x%x\n",
+                   ch, (unsigned)src);
+            rc = src;
+            break;
+        }
+
+        if ((ff_hi_u32)rc == FF_HI_ERR_VDEC_EXIST) {
+            /* Channel ID is held by another VDEC/JPEGD user in the same process;
+               keep claimed temporarily during scan so we skip it, release after loop. */
+            if (external_busy_cnt < FF_HI_VDEC_MAX_CHN_NUM)
+                external_busy[external_busy_cnt++] = ch;
+            continue;
+        }
+
+        chn_bitmap_release(ch);
+        break;
+    }
+
+    for (int i = 0; i < external_busy_cnt; i++)
+        chn_bitmap_release(external_busy[i]);
+
+    if (!ctx->channel_created) {
+        av_log(avctx, AV_LOG_ERROR,
+               "[Ascend] hi_mpi_vdec_create_chn(%dx%d, ref=%u) failed: 0x%x\n",
+               coded_w, coded_h, ref_num, (unsigned)rc);
+        return AVERROR_EXTERNAL;
+    }
+
+    ctx->channel_width  = coded_w;
+    ctx->channel_height = coded_h;
+    ctx->extradata_sent = 0;
+    av_log(avctx, AV_LOG_INFO,
+           "[Ascend] DVPP V2 VDEC ready (device=%d, ch=%d, %dx%d, stride=%ux%u, ref=%u, mode=%s)\n",
+           ctx->device_id, ctx->active_chn, coded_w, coded_h, stride_w, stride_h, ref_num,
+           avctx->pix_fmt == AV_PIX_FMT_ASCEND ? "device-zero-copy" : "host-pinned");
+    return 0;
+}
+
+static int ascend_ensure_channel(AVCodecContext *avctx, int width, int height,
+                                 int coded_w, int coded_h)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    int ret;
+
+    if (ctx->channel_created &&
+        coded_w == ctx->channel_width && coded_h == ctx->channel_height)
+        return 0;
+
+    if (avctx->width <= 0 || avctx->height <= 0) {
+        ret = ff_set_dimensions(avctx, width, height);
+        if (ret < 0)
+            return ret;
+    }
+
+    if (avctx->pix_fmt == AV_PIX_FMT_ASCEND) {
+        ret = ascend_ensure_hw_frames(avctx, width, height);
+        if (ret < 0)
+            return ret;
+    }
+
+    if (ctx->channel_created) {
+        av_log(avctx, AV_LOG_WARNING,
+               "[Ascend] resolution changed %dx%d -> %dx%d, recreating V2 channel\n",
+               ctx->channel_width, ctx->channel_height, coded_w, coded_h);
+        ascend_destroy_channel(ctx);
+        out_pool_clear(ctx, 1);
+        out_pool_unref(ctx->out_pool);
+        ctx->out_pool = out_pool_alloc(ctx->cref, ctx->max_out_bufs);
+        if (!ctx->out_pool)
+            return AVERROR(ENOMEM);
+        ascend_free_host_pool(ctx);
+        ctx->eof_reached = ctx->eos_sent = ctx->eos_done = 0;
+    }
+    return ascend_create_channel(avctx, coded_w, coded_h);
+}
+
+static int has_annexb_start_code(const uint8_t *buf, int size)
+{
+    if (!buf || size < 4)
+        return 0;
+    if (buf[0] == 0 && buf[1] == 0 && buf[2] == 1)
+        return 1;
+    if (buf[0] == 0 && buf[1] == 0 && buf[2] == 0 && buf[3] == 1)
+        return 1;
+    return 0;
+}
+
+static int ascend_send_packet(AVCodecContext *avctx, const AVPacket *pkt)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    ff_hi_vdec_stream stream;
+    ff_hi_vdec_pic_info pic;
+    void *in_dev = NULL;
+    size_t in_cap = 0;
+    void *out_dev = NULL;
+    int width, height, coded_w, coded_h;
+    uint32_t stride_w, stride_h;
+    size_t out_size;
+    size_t extra_sz = 0;
+    size_t total_in_sz;
+    int attempts = 0;
+    int ret;
+
+    if (!pkt->size)
+        return 0;
+
+    get_dimensions(avctx, &width, &height, &coded_w, &coded_h);
+    ret = ascend_ensure_channel(avctx, width, height, coded_w, coded_h);
+    if (ret < 0)
+        return ret;
+
+    stride_w = FFALIGN(coded_w, ASCEND_ALIGN_WIDTH);
+    stride_h = FFALIGN(coded_h, ASCEND_ALIGN_HEIGHT);
+    out_size = (size_t)stride_w * stride_h * 3 / 2;
+
+    if (!ctx->extradata_sent &&
+        avctx->extradata && avctx->extradata_size >= 4 &&
+        has_annexb_start_code(avctx->extradata, avctx->extradata_size)) {
+        if (pkt->size < avctx->extradata_size ||
+            memcmp(pkt->data, avctx->extradata, avctx->extradata_size) != 0)
+            extra_sz = (size_t)avctx->extradata_size;
+        ctx->extradata_sent = 1;
+    }
+
+    total_in_sz = extra_sz + (size_t)pkt->size;
+    ret = in_pool_get(ctx, total_in_sz, &in_dev, &in_cap);
+    if (ret < 0)
+        return ret;
+
+    if (extra_sz > 0) {
+        if (ctx->aclrtMemcpy(in_dev, in_cap, avctx->extradata, extra_sz,
+                             ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
+            ctx->aclrtMemcpy((uint8_t *)in_dev + extra_sz, in_cap - extra_sz,
+                             pkt->data, pkt->size,
+                             ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
+            in_pool_put(ctx, in_dev, in_cap);
+            return AVERROR_EXTERNAL;
+        }
+    } else {
+        if (ctx->aclrtMemcpy(in_dev, in_cap, pkt->data, pkt->size,
+                             ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
+            in_pool_put(ctx, in_dev, in_cap);
+            return AVERROR_EXTERNAL;
+        }
+    }
+
+    out_dev = out_pool_get(ctx, out_size);
+    if (!out_dev) {
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR(ENOMEM);
+    }
+
+    memset(&stream, 0, sizeof(stream));
+    stream.addr          = (ff_hi_u8 *)in_dev;
+    stream.len           = (ff_hi_u32)total_in_sz;
+    stream.end_of_frame  = 1;
+    stream.end_of_stream = 0;
+    stream.need_display  = 1;
+    stream.pts           = (ff_hi_u64)pkt->pts;
+
+    memset(&pic, 0, sizeof(pic));
+    pic.width         = (ff_hi_u32)coded_w;
+    pic.height        = (ff_hi_u32)coded_h;
+    pic.width_stride  = stride_w;
+    pic.height_stride = stride_h;
+    pic.pixel_format  = FF_HI_PIXEL_FORMAT_YUV_SP_420;
+    pic.vir_addr      = (ff_hi_u64)(uintptr_t)out_dev;
+    pic.buffer_size   = (ff_hi_u32)out_size;
+
+    for (;;) {
+        ff_hi_s32 rc = ascend_mpi.hi_mpi_vdec_send_stream(ctx->active_chn, &stream, &pic, 200);
+        if (rc == 0)
+            break;
+        if (((ff_hi_u32)rc == FF_HI_ERR_VDEC_BUF_FULL ||
+             (ff_hi_u32)rc == FF_HI_ERR_VDEC_BUSY) && attempts++ < 25) {
+            av_usleep(2000);
+            continue;
+        }
+        av_log(avctx, AV_LOG_ERROR,
+               "[Ascend] hi_mpi_vdec_send_stream(ch=%d) failed: 0x%x\n",
+               ctx->active_chn, (unsigned)rc);
+        out_pool_put(ctx, out_dev);
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR_EXTERNAL;
+    }
+
+    active_track_push(ctx, in_dev, in_cap, out_dev);
+    ctx->in_flight++;
+    return 0;
+}
+
+static int ascend_send_eos(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    ff_hi_vdec_stream eos;
+    ff_hi_vdec_pic_info pic;
+    ff_hi_s32 rc;
+
+    if (!ctx->channel_created) {
+        ctx->eos_done = 1;
+        return 0;
+    }
+
+    memset(&eos, 0, sizeof(eos));
+    memset(&pic, 0, sizeof(pic));
+    eos.end_of_stream = 1;
+
+    rc = ascend_mpi.hi_mpi_vdec_send_stream(ctx->active_chn, &eos, &pic, 1000);
+    if (rc != 0) {
+        av_log(avctx, AV_LOG_WARNING,
+               "[Ascend] V2 EOS send(ch=%d) returned: 0x%x\n",
+               ctx->active_chn, (unsigned)rc);
+    }
+    return 0;
+}
+
+static int ascend_wrap_output_frame(AVCodecContext *avctx, AVFrame *frame,
+                                    const ff_hi_video_frame *vf)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    void *dev = vf->virt_addr[0];
+    uint32_t desc_w = vf->width;
+    uint32_t desc_h = vf->height;
+    uint32_t stride_w = vf->width_stride[0];
+    uint32_t stride_h = vf->height_stride[0];
+    int width = desc_w ? (avctx->width > 0 ? FFMIN(avctx->width, (int)desc_w) : (int)desc_w)
+                       : (avctx->width > 0 ? avctx->width : 1920);
+    int height = desc_h ? (avctx->height > 0 ? FFMIN(avctx->height, (int)desc_h) : (int)desc_h)
+                        : (avctx->height > 0 ? avctx->height : 1080);
+    int chroma_h;
+    size_t y_size, uv_size, copy_size;
+    int ret;
+
+    if (!dev || !stride_w || !stride_h || width <= 0 || height <= 0 ||
+        stride_w < (uint32_t)width || stride_h < (uint32_t)height) {
+        av_log(avctx, AV_LOG_WARNING,
+               "[Ascend] invalid V2 output frame: %dx%d stride %ux%u\n",
+               width, height, stride_w, stride_h);
+        if (dev)
+            out_pool_put(ctx, dev);
+        return AVERROR_EXTERNAL;
+    }
+
+    if (avctx->width <= 0 || avctx->height <= 0)
+        ff_set_dimensions(avctx, width, height);
+
+    y_size = (size_t)stride_w * stride_h;
+    chroma_h = (height + 1) / 2;
+    uv_size = (size_t)stride_w * chroma_h;
+    copy_size = y_size + uv_size;
+
+    frame->width  = width;
+    frame->height = height;
+    frame->format = avctx->pix_fmt;
+    ret = ff_decode_frame_props(avctx, frame);
+    if (ret < 0) {
+        out_pool_put(ctx, dev);
+        return ret;
+    }
+    frame->pts     = (int64_t)vf->pts;
+    frame->pkt_dts = AV_NOPTS_VALUE;
+
+    if (avctx->pix_fmt == AV_PIX_FMT_ASCEND) {
+        ret = ascend_ensure_hw_frames(avctx, width, height);
+        if (ret < 0) {
+            out_pool_put(ctx, dev);
+            return ret;
+        }
+
+        atomic_fetch_add(&ctx->out_pool->refs, 1);
+        frame->buf[0] = av_buffer_create((uint8_t *)dev, copy_size,
+                                         ascend_dev_frame_free,
+                                         ctx->out_pool, 0);
+        if (!frame->buf[0]) {
+            out_pool_unref(ctx->out_pool);
+            out_pool_put(ctx, dev);
+            return AVERROR(ENOMEM);
+        }
+        frame->hw_frames_ctx = av_buffer_ref(avctx->hw_frames_ctx);
+        if (!frame->hw_frames_ctx) {
+            av_frame_unref(frame);
+            return AVERROR(ENOMEM);
+        }
+        frame->data[0]     = (uint8_t *)dev;
+        frame->linesize[0] = (int)stride_w;
+        frame->data[1]     = (uint8_t *)dev + y_size;
+        frame->linesize[1] = (int)stride_w;
+    } else {
+        ret = ascend_ensure_host_pool(ctx, copy_size);
+        if (ret < 0) {
+            out_pool_put(ctx, dev);
+            return ret;
+        }
+
+        frame->buf[0] = av_buffer_pool_get(ctx->host_frame_pool);
+        if (!frame->buf[0]) {
+            out_pool_put(ctx, dev);
+            return AVERROR(ENOMEM);
+        }
+
+        if (ctx->aclrtMemcpy(frame->buf[0]->data, copy_size,
+                             dev, copy_size,
+                             ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
+            out_pool_put(ctx, dev);
+            av_frame_unref(frame);
+            return AVERROR_EXTERNAL;
+        }
+        out_pool_put(ctx, dev);
+
+        frame->data[0]     = frame->buf[0]->data;
+        frame->linesize[0] = (int)stride_w;
+        frame->data[1]     = frame->buf[0]->data + y_size;
+        frame->linesize[1] = (int)stride_w;
+    }
+    return 0;
+}
+
+/*
+ * Pull one completed frame from V2 VDEC.
+ * Returns:
+ *   0               - valid decoded frame written into `frame`
+ *   AVERROR(EAGAIN) - no ready frame within timeout_ms (corrupt frames discarded)
+ *   < 0             - fatal error
+ */
+static int ascend_pull_one_frame(AVCodecContext *avctx, AVFrame *frame, int timeout_ms)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    ff_hi_video_frame_info fi;
+    ff_hi_vdec_supplement_info sup;
+    ff_hi_vdec_stream ost;
+    ff_hi_s32 rc;
+
+    if (!ctx->channel_created)
+        return AVERROR(EAGAIN);
+
+    for (;;) {
+        memset(&fi, 0, sizeof(fi));
+        memset(&sup, 0, sizeof(sup));
+        memset(&ost, 0, sizeof(ost));
+
+        rc = ascend_mpi.hi_mpi_vdec_get_frame(ctx->active_chn, &fi, &sup, &ost, timeout_ms);
+        if (rc != 0) {
+            if ((ff_hi_u32)rc == FF_HI_ERR_VDEC_BUF_EMPTY)
+                return AVERROR(EAGAIN);
+            av_log(avctx, AV_LOG_DEBUG,
+                   "[Ascend] hi_mpi_vdec_get_frame(ch=%d) returned 0x%x\n",
+                   ctx->active_chn, (unsigned)rc);
+            return AVERROR(EAGAIN);
+        }
+
+        if (ost.addr) {
+            active_reclaim_in(ctx, ost.addr);
+            if (ctx->in_flight > 0)
+                ctx->in_flight--;
+        }
+        if (fi.v_frame.virt_addr[0])
+            active_remove_out(ctx, fi.v_frame.virt_addr[0]);
+
+        ascend_mpi.hi_mpi_vdec_release_frame(ctx->active_chn, &fi);
+
+        if (fi.v_frame.frame_flag == 0 && fi.v_frame.virt_addr[0] &&
+            fi.v_frame.width > 0 && fi.v_frame.height > 0) {
+            return ascend_wrap_output_frame(avctx, frame, &fi.v_frame);
+        }
+
+        if (fi.v_frame.virt_addr[0])
+            out_pool_put(ctx, fi.v_frame.virt_addr[0]);
+
+        av_log(avctx, AV_LOG_DEBUG,
+               "[Ascend] V2 VDEC dropped non-display/error frame (ch=%d, flag=0x%x)\n",
+               ctx->active_chn, fi.v_frame.frame_flag);
+
+        /* Non-blocking retry to check if another valid frame is already queued */
+        timeout_ms = 0;
+    }
+}
+
+static int ascend_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    int sent_pkt = 0;
+    int ret;
+
+    if (!ctx->initialized)
+        return AVERROR(EINVAL);
+    if (ctx->context) {
+        if (ctx->aclrtSetCurrentContext(ctx->context) != ACL_SUCCESS)
+            return AVERROR_EXTERNAL;
+    }
+
+    /* 1. Deliver any already-completed frame immediately with zero wait */
+    if (ctx->channel_created && ctx->in_flight > 0) {
+        ret = ascend_pull_one_frame(avctx, frame, 0);
+        if (ret != AVERROR(EAGAIN))
+            return ret;
+    }
+
+    /* 2. Feed new packets while pipeline has headroom */
+    while (!ctx->eof_reached) {
+        if (ctx->channel_created &&
+            (ctx->in_flight >= ASCEND_MAX_INFLIGHT ||
+             (avctx->pix_fmt == AV_PIX_FMT_ASCEND && out_pool_at_cap(ctx)))) {
+            /* Backpressure: wait briefly for a decoded frame to free a slot */
+            for (int w = 0; w < 25 &&
+                 (ctx->in_flight >= ASCEND_MAX_INFLIGHT ||
+                  (avctx->pix_fmt == AV_PIX_FMT_ASCEND && out_pool_at_cap(ctx))); w++) {
+                ret = ascend_pull_one_frame(avctx, frame, 10);
+                if (ret != AVERROR(EAGAIN))
+                    return ret;
+            }
+            if (ctx->in_flight >= ASCEND_MAX_INFLIGHT)
+                break;
+        }
+
+        ret = ff_decode_get_packet(avctx, ctx->pkt);
+        if (ret == AVERROR_EOF) {
+            ctx->eof_reached = 1;
+            break;
+        } else if (ret == AVERROR(EAGAIN)) {
+            break;
+        } else if (ret < 0) {
+            return ret;
+        }
+
+        ret = ascend_send_packet(avctx, ctx->pkt);
+        av_packet_unref(ctx->pkt);
+        if (ret < 0)
+            return ret;
+        sent_pkt = 1;
+
+        ret = ascend_pull_one_frame(avctx, frame, 0);
+        if (ret != AVERROR(EAGAIN))
+            return ret;
+    }
+
+    /* 3. Non-EOF: short wait if pipeline is already primed, else return EAGAIN */
+    if (!ctx->eof_reached) {
+        if (sent_pkt && ctx->in_flight >= 2) {
+            ret = ascend_pull_one_frame(avctx, frame, 5);
+            if (ret != AVERROR(EAGAIN))
+                return ret;
+        }
+        return AVERROR(EAGAIN);
+    }
+
+    /* 4. EOF drain */
+    if (ctx->eos_done || !ctx->channel_created)
+        return AVERROR_EOF;
+
+    if (!ctx->eos_sent) {
+        ctx->eos_sent = 1;
+        ascend_send_eos(avctx);
+    }
+
+    for (int waited = 0; waited < 1000; ) {
+        int t = ctx->in_flight > 0 ? 50 : 5;
+        ret = ascend_pull_one_frame(avctx, frame, t);
+        if (ret != AVERROR(EAGAIN))
+            return ret;
+        if (ctx->in_flight <= 0)
+            break;
+        waited += t;
+    }
+
+    ctx->eos_done = 1;
+    return AVERROR_EOF;
+}
+
+static av_cold void ascend_flush(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    int width, height, coded_w, coded_h;
+
+    if (!ctx->initialized)
+        return;
+    if (ctx->context)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    ascend_destroy_channel(ctx);
+    if (ctx->pkt)
+        av_packet_unref(ctx->pkt);
+    ctx->eof_reached = ctx->eos_sent = ctx->eos_done = 0;
+    ctx->extradata_sent = 0;
+
+    get_dimensions(avctx, &width, &height, &coded_w, &coded_h);
+    if (coded_w > 0 && coded_h > 0 && !ctx->channel_created)
+        ascend_create_channel(avctx, coded_w, coded_h);
+}
+
+static av_cold int ascend_init_decoder(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    static const enum AVPixelFormat pix_fmts_hw[] = {
+        AV_PIX_FMT_ASCEND,
+        AV_PIX_FMT_NV12,
+        AV_PIX_FMT_NONE
+    };
+    void *dvpp_lib_unused = NULL;
+    int ret;
+
+    ctx->codec_id        = avctx->codec_id;
+    ctx->active_chn      = -1;
+    ctx->channel_created = 0;
+    ctx->in_pool_count   = 0;
+    ctx->in_active_count = 0;
+    ctx->out_active_count = 0;
+    ctx->in_flight       = 0;
+    ctx->eof_reached = ctx->eos_sent = ctx->eos_done = 0;
+    ctx->extradata_sent  = 0;
+
+    if (avctx->hw_frames_ctx) {
+        AVHWFramesContext *frames_ctx = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+        AVAscendDeviceContext *hwctx = frames_ctx->device_ctx->hwctx;
+        ctx->device_id = hwctx->device_id;
+    } else if (avctx->hw_device_ctx) {
+        AVHWDeviceContext *dev_ctx = (AVHWDeviceContext *)avctx->hw_device_ctx->data;
+        if (dev_ctx->type == AV_HWDEVICE_TYPE_ASCEND) {
+            AVAscendDeviceContext *hwctx = dev_ctx->hwctx;
+            ctx->device_id = hwctx->device_id;
+        }
+    }
+
+    ctx->pkt = av_packet_alloc();
+    if (!ctx->pkt)
+        return AVERROR(ENOMEM);
+
+    AscendContextRef *cref = av_mallocz(sizeof(*cref));
+    if (!cref)
+        return AVERROR(ENOMEM);
+    atomic_init(&cref->refs, 1);
+    cref->device_id = ctx->device_id;
+
+    ret = av_ascend_global_acquire(ctx->device_id, &ctx->acl_lib,
+                                   &dvpp_lib_unused, (void **)&cref->context, avctx);
+    if (ret < 0) {
+        av_free(cref);
+        return ret;
+    }
+    cref->aclrtSetCurrentContext = (void *)get_dyn_sym(ctx->acl_lib, "aclrtSetCurrentContext");
+
+    ctx->cref    = cref;
+    ctx->context = cref->context;
+
+    ret = load_acl_symbols(avctx);
+    if (ret < 0)
+        return ret;
+
+    ret = ensure_mpi_ready(avctx);
+    if (ret < 0)
+        return ret;
+
+    cref->hi_mpi_dvpp_free = ascend_mpi.hi_mpi_dvpp_free;
+
+    ctx->out_pool = out_pool_alloc(ctx->cref,
+                                   ctx->max_out_bufs > 0 ? ctx->max_out_bufs : ASCEND_MAX_OUT_BUFS);
+    if (!ctx->out_pool)
+        return AVERROR(ENOMEM);
+
+    avctx->sw_pix_fmt = AV_PIX_FMT_NV12;
+    if (ctx->device_output) {
+        avctx->pix_fmt = AV_PIX_FMT_ASCEND;
+    } else {
+        ret = ff_get_format(avctx, pix_fmts_hw);
+        if (ret < 0)
+            return ret;
+        avctx->pix_fmt = ret;
+    }
+
+    if (avctx->pix_fmt == AV_PIX_FMT_ASCEND) {
+        int w, h, cw, ch;
+        get_dimensions(avctx, &w, &h, &cw, &ch);
+        ret = ascend_ensure_hw_frames(avctx, w, h);
+        if (ret < 0)
+            return ret;
+    }
+
+    ctx->initialized = 1;
+
+    if (ctx->channel_id >= 0)
+        av_log(avctx, AV_LOG_INFO,
+               "[Ascend] DVPP V2 decoder initialized (device=%d, channel=%d, pix_fmt=%s)\n",
+               ctx->device_id, ctx->channel_id, av_get_pix_fmt_name(avctx->pix_fmt));
+    else
+        av_log(avctx, AV_LOG_INFO,
+               "[Ascend] DVPP V2 decoder initialized (device=%d, channel=auto, pix_fmt=%s)\n",
+               ctx->device_id, av_get_pix_fmt_name(avctx->pix_fmt));
+    return 0;
+}
+
+static av_cold int ascend_close_decoder(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    ascend_destroy_channel(ctx);
+    out_pool_clear(ctx, 1);
+    out_pool_unref(ctx->out_pool);
+    ctx->out_pool = NULL;
+    in_pool_clear(ctx);
+    ascend_free_host_pool(ctx);
+    av_packet_free(&ctx->pkt);
+    av_buffer_unref(&ctx->hw_frames_ref);
+    av_buffer_unref(&ctx->hw_device_ref);
+    if (ctx->cref) {
+        AscendContextRef *cref = ctx->cref;
+        ctx->cref = NULL;
+        ctx->context = NULL;
+        ascend_cref_unref(cref);
+    }
+    ctx->acl_lib = NULL;
+    ctx->initialized = 0;
+    return 0;
+}
