+
+_Static_assert(sizeof(ff_hi_vdec_chn_attr) == 40, "hi_vdec_chn_attr ABI size");
+_Static_assert(sizeof(ff_hi_vdec_stream) == 48, "hi_vdec_stream ABI size");
+_Static_assert(offsetof(ff_hi_vdec_stream, pts) == 16, "hi_vdec_stream.pts ABI offset");
