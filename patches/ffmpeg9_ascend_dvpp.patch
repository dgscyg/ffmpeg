+#include <pthread.h>
+#include <stdatomic.h>
+#include <time.h>
+#include <unistd.h>
+
+typedef struct AscendInBuf {
+    void *ptr;
+    size_t cap;
+} AscendInBuf;
+
+/*
+ * Reference-counted Ascend device context holder.
+ * Allows the decoder and downstream AscendOutPool instances to share the exact
+ * same aclrtContext. When the decoder closes, downstream frames keeping AscendOutPool
+ * alive continue to hold a reference to AscendContextRef so acldvppFree can safely run,
+ * without creating a conflicting second context that breaks aclvdecSendFrame.
+ */
+typedef struct AscendContextRef {
+    atomic_int refs;
+    int device_id;
+    aclrtContext context;
+    void *acl_lib;
+    void *dvpp_lib;
+    aclError (*aclrtSetCurrentContext)(aclrtContext);
+    aclError (*acldvppFree)(void *);
+} AscendContextRef;
+
+typedef struct AscendOutPool {
+    atomic_int refs;
+    pthread_mutex_t lock;
+    int closed;
+    AscendContextRef *cref;
+    void *bufs[ASCEND_OUT_POOL_SIZE];
+    int count;
+    size_t buf_size;
+} AscendOutPool;
+
+typedef struct AscendFrameMeta {
+    struct AscendDecodeContext *ctx;
+    size_t in_cap;
+    int64_t pts;
+    int64_t dts;
+} AscendFrameMeta;
+
+typedef struct AscendFrame {
+    acldvppPicDesc *pic;
+    int64_t pts;
+    int64_t dts;
+} AscendFrame;
+
+typedef struct AscendDecodeContext {
+    const AVClass *class;
+
+    void *acl_lib;
+    void *dvpp_lib;
+
+    int device_id;
+    int channel_id;
+    int device_output;
+    int codec_id;
+    int initialized;
+    int acl_acquired;
+
+    AscendContextRef *cref;
+    aclrtContext context;
+    aclvdecChannelDesc *channel_desc;
+    int channel_width;
+    int channel_height;
+
+    AVBufferRef *hw_device_ref;
+    AVBufferRef *hw_frames_ref;
+
+    pthread_t callback_thread;
+    uint64_t callback_tid;
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+    pthread_cond_t thread_started;
+    int callback_thread_started;
+    atomic_int running;
+    atomic_int in_flight;
+    atomic_int cb_count;
+
+    AscendFrame queue[ASCEND_QUEUE_DEPTH];
+    int queue_head;
+    int queue_tail;
+    int queue_count;
+
+    int eof_reached;
+    int eos_sent;
+    int eos_done;
+
+    AVPacket *pkt;
+    AVBufferPool *host_frame_pool;
+    size_t host_frame_size;
+
+    AscendOutPool *out_pool;
+
+    AscendInBuf in_pool[ASCEND_IN_POOL_SIZE];
+    int in_pool_count;
+
+    /* libascendcl.so */
+    aclError (*aclrtSetCurrentContext)(aclrtContext);
+    aclError (*aclrtProcessReport)(int32_t);
+    aclError (*aclrtMallocHost)(void **, size_t);
+    aclError (*aclrtFreeHost)(void *);
+    aclError (*aclrtMemcpy)(void *, size_t, const void *, size_t, aclrtMemcpyKind);
+
+    /* libacl_dvpp.so */
+    aclError (*acldvppMalloc)(void **, size_t);
+    aclError (*acldvppFree)(void *);
+
+    aclvdecChannelDesc *(*aclvdecCreateChannelDesc)(void);
+    aclError (*aclvdecDestroyChannelDesc)(aclvdecChannelDesc *);
+    aclError (*aclvdecSetChannelDescChannelId)(aclvdecChannelDesc *, uint32_t);
+    aclError (*aclvdecSetChannelDescThreadId)(aclvdecChannelDesc *, uint64_t);
+    aclError (*aclvdecSetChannelDescCallback)(aclvdecChannelDesc *, aclvdecCallback);
+    aclError (*aclvdecSetChannelDescEnType)(aclvdecChannelDesc *, acldvppStreamFormat);
+    aclError (*aclvdecSetChannelDescOutPicFormat)(aclvdecChannelDesc *, acldvppPixelFormat);
+    aclError (*aclvdecSetChannelDescOutPicWidth)(aclvdecChannelDesc *, uint32_t);
+    aclError (*aclvdecSetChannelDescOutPicHeight)(aclvdecChannelDesc *, uint32_t);
+    aclError (*aclvdecCreateChannel)(aclvdecChannelDesc *);
+    aclError (*aclvdecDestroyChannel)(aclvdecChannelDesc *);
+
+    acldvppStreamDesc *(*acldvppCreateStreamDesc)(void);
+    aclError (*acldvppDestroyStreamDesc)(acldvppStreamDesc *);
+    aclError (*acldvppSetStreamDescData)(acldvppStreamDesc *, void *);
+    aclError (*acldvppSetStreamDescSize)(acldvppStreamDesc *, uint32_t);
+    aclError (*acldvppSetStreamDescEos)(acldvppStreamDesc *, uint8_t);
+    void *(*acldvppGetStreamDescData)(const acldvppStreamDesc *);
+
+    acldvppPicDesc *(*acldvppCreatePicDesc)(void);
+    aclError (*acldvppDestroyPicDesc)(acldvppPicDesc *);
+    aclError (*acldvppSetPicDescData)(acldvppPicDesc *, void *);
+    aclError (*acldvppSetPicDescSize)(acldvppPicDesc *, uint32_t);
+    aclError (*acldvppSetPicDescFormat)(acldvppPicDesc *, acldvppPixelFormat);
+    aclError (*acldvppSetPicDescWidth)(acldvppPicDesc *, uint32_t);
+    aclError (*acldvppSetPicDescHeight)(acldvppPicDesc *, uint32_t);
+    aclError (*acldvppSetPicDescWidthStride)(acldvppPicDesc *, uint32_t);
+    aclError (*acldvppSetPicDescHeightStride)(acldvppPicDesc *, uint32_t);
+    void *(*acldvppGetPicDescData)(const acldvppPicDesc *);
+    uint32_t (*acldvppGetPicDescWidth)(const acldvppPicDesc *);
+    uint32_t (*acldvppGetPicDescHeight)(const acldvppPicDesc *);
+    uint32_t (*acldvppGetPicDescWidthStride)(const acldvppPicDesc *);
+    uint32_t (*acldvppGetPicDescHeightStride)(const acldvppPicDesc *);
+    uint32_t (*acldvppGetPicDescRetCode)(const acldvppPicDesc *);
+
+    aclError (*aclvdecSendFrame)(aclvdecChannelDesc *, acldvppStreamDesc *,
+                                 acldvppPicDesc *, aclvdecFrameConfig *, void *);
+} AscendDecodeContext;
+
+static atomic_int ascend_channel_counter;
+
+static void *get_dyn_sym(void *h, const char *name)
+{
+    return h ? dlsym(h, name) : NULL;
+}
+
+static uint64_t ascend_thread_id(void)
+{
+    return (uint64_t)(uintptr_t)pthread_self();
+}
+
+static AscendOutPool *out_pool_alloc(AscendContextRef *cref)
+{
+    AscendOutPool *p;
+    if (!cref)
+        return NULL;
+    p = av_mallocz(sizeof(*p));
+    if (!p)
+        return NULL;
+    atomic_init(&p->refs, 1);
+    pthread_mutex_init(&p->lock, NULL);
+    atomic_fetch_add(&cref->refs, 1);
+    p->cref = cref;
+    return p;
+}
+
+static void out_pool_unref(AscendOutPool *p)
+{
+    if (!p)
+        return;
+    if (atomic_fetch_sub(&p->refs, 1) == 1) {
+        AscendContextRef *cref = p->cref;
+        if (cref && cref->context && cref->aclrtSetCurrentContext)
+            cref->aclrtSetCurrentContext(cref->context);
+        for (int i = 0; i < p->count; i++) {
+            if (p->bufs[i] && cref && cref->acldvppFree)
+                cref->acldvppFree(p->bufs[i]);
+        }
+        pthread_mutex_destroy(&p->lock);
+        av_free(p);
+        if (cref && atomic_fetch_sub(&cref->refs, 1) == 1) {
+            av_ascend_global_release(cref->device_id, cref->context);
+            av_free(cref);
+        }
+    }
+}
+
+static void out_pool_put_raw(AscendOutPool *p, void *dev)
+{
+    if (!p || !dev)
+        return;
+    pthread_mutex_lock(&p->lock);
+    if (!p->closed && p->count < ASCEND_OUT_POOL_SIZE) {
+        p->bufs[p->count++] = dev;
+        pthread_mutex_unlock(&p->lock);
+        return;
+    }
+    pthread_mutex_unlock(&p->lock);
+    if (p->cref && p->cref->acldvppFree) {
+        if (p->cref->context && p->cref->aclrtSetCurrentContext)
+            p->cref->aclrtSetCurrentContext(p->cref->context);
+        p->cref->acldvppFree(dev);
+    }
+}
+
+static void out_pool_put(AscendDecodeContext *ctx, void *dev)
+{
+    out_pool_put_raw(ctx->out_pool, dev);
+}
+
+static void out_pool_clear(AscendDecodeContext *ctx, int mark_closed)
+{
+    AscendOutPool *p = ctx->out_pool;
+    if (!p)
+        return;
+    pthread_mutex_lock(&p->lock);
+    if (mark_closed)
+        p->closed = 1;
+    if (p->cref && p->cref->context && p->cref->aclrtSetCurrentContext)
+        p->cref->aclrtSetCurrentContext(p->cref->context);
+    while (p->count > 0) {
+        void *dev = p->bufs[--p->count];
+        if (dev && p->cref && p->cref->acldvppFree)
+            p->cref->acldvppFree(dev);
+    }
+    p->buf_size = 0;
+    pthread_mutex_unlock(&p->lock);
+}
+
+static void *out_pool_get(AscendDecodeContext *ctx, size_t size)
+{
+    AscendOutPool *p = ctx->out_pool;
+    void *dev = NULL;
+
+    if (!p)
+        return NULL;
+    pthread_mutex_lock(&p->lock);
+    if (p->buf_size != size) {
+        if (p->cref && p->cref->context && p->cref->aclrtSetCurrentContext)
+            p->cref->aclrtSetCurrentContext(p->cref->context);
+        while (p->count > 0) {
+            void *old = p->bufs[--p->count];
+            if (old && p->cref && p->cref->acldvppFree)
+                p->cref->acldvppFree(old);
+        }
+        p->buf_size = size;
+    }
+    if (p->count > 0) {
+        dev = p->bufs[--p->count];
+        pthread_mutex_unlock(&p->lock);
+        return dev;
+    }
+    pthread_mutex_unlock(&p->lock);
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+    if (ctx->acldvppMalloc(&dev, size) != ACL_SUCCESS)
+        return NULL;
+    return dev;
+}
+
+static void ascend_dev_frame_free(void *opaque, uint8_t *data)
+{
+    AscendOutPool *p = opaque;
+    if (data)
+        out_pool_put_raw(p, data);
+    out_pool_unref(p);
+}
+
+static int in_pool_get(AscendDecodeContext *ctx, size_t need_size,
+                       void **out_ptr, size_t *out_cap)
+{
+    void *stale_ptr = NULL;
+    size_t alloc_size;
+
+    pthread_mutex_lock(&ctx->lock);
+    if (ctx->in_pool_count > 0) {
+        AscendInBuf b = ctx->in_pool[--ctx->in_pool_count];
+        pthread_mutex_unlock(&ctx->lock);
+        if (b.cap >= need_size) {
+            *out_ptr = b.ptr;
+            *out_cap = b.cap;
+            return 0;
+        }
+        stale_ptr = b.ptr;
+    } else {
+        pthread_mutex_unlock(&ctx->lock);
+    }
+
+    if (stale_ptr && ctx->acldvppFree)
+        ctx->acldvppFree(stale_ptr);
+
+    alloc_size = FFMAX(need_size, (size_t)ASCEND_IN_MIN_ALLOC);
+    if (ctx->acldvppMalloc(out_ptr, alloc_size) != ACL_SUCCESS || !*out_ptr)
+        return AVERROR(ENOMEM);
+    *out_cap = alloc_size;
+    return 0;
+}
+
+static void in_pool_put(AscendDecodeContext *ctx, void *ptr, size_t cap)
+{
+    if (!ptr)
+        return;
+    if (cap > 0) {
+        pthread_mutex_lock(&ctx->lock);
+        if (ctx->in_pool_count < ASCEND_IN_POOL_SIZE) {
+            ctx->in_pool[ctx->in_pool_count].ptr = ptr;
+            ctx->in_pool[ctx->in_pool_count].cap = cap;
+            ctx->in_pool_count++;
+            pthread_mutex_unlock(&ctx->lock);
+            return;
+        }
+        pthread_mutex_unlock(&ctx->lock);
+    }
+    if (ctx->acldvppFree)
+        ctx->acldvppFree(ptr);
+}
+
+static void in_pool_clear(AscendDecodeContext *ctx)
+{
+    pthread_mutex_lock(&ctx->lock);
+    while (ctx->in_pool_count > 0) {
+        void *ptr = ctx->in_pool[--ctx->in_pool_count].ptr;
+        if (ptr && ctx->acldvppFree)
+            ctx->acldvppFree(ptr);
+    }
+    pthread_mutex_unlock(&ctx->lock);
+}
+
+static void ascend_host_buf_free(void *opaque, uint8_t *data)
+{
+    aclError (*free_host)(void *) = opaque;
+    if (data && free_host)
+        free_host(data);
+}
+
+static AVBufferRef *ascend_host_pool_alloc(void *opaque, size_t size)
+{
+    AscendDecodeContext *ctx = opaque;
+    void *ptr = NULL;
+    AVBufferRef *ref;
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+    if (ctx->aclrtMallocHost(&ptr, size) == ACL_SUCCESS && ptr) {
+        ref = av_buffer_create((uint8_t *)ptr, size, ascend_host_buf_free,
+                               ctx->aclrtFreeHost, 0);
+        if (!ref) {
+            ctx->aclrtFreeHost(ptr);
+            return NULL;
+        }
+        return ref;
+    }
+    return av_buffer_alloc(size);
+}
+
+static int ascend_ensure_host_pool(AscendDecodeContext *ctx, size_t need_size)
+{
+    if (ctx->host_frame_pool && ctx->host_frame_size >= need_size)
+        return 0;
+    av_buffer_pool_uninit(&ctx->host_frame_pool);
+    ctx->host_frame_size = 0;
+    ctx->host_frame_pool = av_buffer_pool_init2(need_size, ctx,
+                                                ascend_host_pool_alloc, NULL);
+    if (!ctx->host_frame_pool)
+        return AVERROR(ENOMEM);
+    ctx->host_frame_size = need_size;
+    return 0;
+}
+
+static void ascend_free_host_pool(AscendDecodeContext *ctx)
+{
+    av_buffer_pool_uninit(&ctx->host_frame_pool);
+    ctx->host_frame_size = 0;
+}
+
+static void queue_clear_locked(AscendDecodeContext *ctx)
+{
+    while (ctx->queue_count > 0) {
+        AscendFrame *f = &ctx->queue[ctx->queue_head];
+        if (f->pic) {
+            void *dev = ctx->acldvppGetPicDescData(f->pic);
+            if (dev)
+                out_pool_put(ctx, dev);
+            ctx->acldvppDestroyPicDesc(f->pic);
+            f->pic = NULL;
+        }
+        ctx->queue_head = (ctx->queue_head + 1) % ASCEND_QUEUE_DEPTH;
+        ctx->queue_count--;
+    }
+    ctx->queue_head = ctx->queue_tail = 0;
+}
+
+static void queue_clear(AscendDecodeContext *ctx)
+{
+    pthread_mutex_lock(&ctx->lock);
+    queue_clear_locked(ctx);
+    pthread_mutex_unlock(&ctx->lock);
+}
+
+static void queue_push(AscendDecodeContext *ctx, acldvppPicDesc *pic,
+                       int64_t pts, int64_t dts)
+{
+    pthread_mutex_lock(&ctx->lock);
+    if (ctx->queue_count == ASCEND_QUEUE_DEPTH) {
+        AscendFrame *old = &ctx->queue[ctx->queue_head];
+        av_log(NULL, AV_LOG_WARNING, "[Ascend] output queue full, frame dropped\n");
+        if (old->pic) {
+            void *dev = ctx->acldvppGetPicDescData(old->pic);
+            if (dev)
+                out_pool_put(ctx, dev);
+            ctx->acldvppDestroyPicDesc(old->pic);
+            old->pic = NULL;
+        }
+        ctx->queue_head = (ctx->queue_head + 1) % ASCEND_QUEUE_DEPTH;
+        ctx->queue_count--;
+    }
+    ctx->queue[ctx->queue_tail].pic = pic;
+    ctx->queue[ctx->queue_tail].pts = pts;
+    ctx->queue[ctx->queue_tail].dts = dts;
+    ctx->queue_tail = (ctx->queue_tail + 1) % ASCEND_QUEUE_DEPTH;
+    ctx->queue_count++;
+    pthread_cond_broadcast(&ctx->cond);
+    pthread_mutex_unlock(&ctx->lock);
+}
+
+static void *ascend_callback_thread(void *arg)
+{
+    AscendDecodeContext *ctx = arg;
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    pthread_mutex_lock(&ctx->lock);
+    ctx->callback_tid = ascend_thread_id();
+    ctx->callback_thread_started = 1;
+    pthread_cond_broadcast(&ctx->thread_started);
+    pthread_mutex_unlock(&ctx->lock);
+
+    while (atomic_load(&ctx->running))
+        ctx->aclrtProcessReport(100);
+
+    return NULL;
+}
+
+static void ascend_vdec_callback(acldvppStreamDesc *input,
+                                 acldvppPicDesc *output, void *user_data)
+{
+    AscendFrameMeta *meta = user_data;
+    AscendDecodeContext *ctx = meta ? meta->ctx : NULL;
+    int pushed = 0;
+
+    if (input && ctx) {
+        void *in_dev = ctx->acldvppGetStreamDescData(input);
+        if (in_dev)
+            in_pool_put(ctx, in_dev, meta ? meta->in_cap : 0);
+        ctx->acldvppDestroyStreamDesc(input);
+    }
+
+    if (meta) {
+        atomic_fetch_sub(&ctx->in_flight, 1);
+        atomic_fetch_add(&ctx->cb_count, 1);
+    }
+
+    if (output && ctx) {
+        uint32_t ret_code = ctx->acldvppGetPicDescRetCode(output);
+        if (!ret_code) {
+            queue_push(ctx, output, meta ? meta->pts : AV_NOPTS_VALUE,
+                       meta ? meta->dts : AV_NOPTS_VALUE);
+            pushed = 1;
+        } else {
+            void *dev = ctx->acldvppGetPicDescData(output);
+            if (dev)
+                out_pool_put(ctx, dev);
+            ctx->acldvppDestroyPicDesc(output);
+            av_log(NULL, ret_code == 0x20000 ? AV_LOG_DEBUG : AV_LOG_WARNING,
+                   "[Ascend] VDEC frame failed, retCode=0x%x\n", ret_code);
+        }
+    }
+
+    if (meta) {
+        if (!pushed) {
+            pthread_mutex_lock(&ctx->lock);
+            pthread_cond_broadcast(&ctx->cond);
+            pthread_mutex_unlock(&ctx->lock);
+        }
+        av_free(meta);
+    }
+}
+
+static int load_symbols(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    void *acl = ctx->acl_lib;
+    void *dvpp = ctx->dvpp_lib;
+
+#define LOAD_SYM(field, lib)                                              \
+    do {                                                                  \
+        ctx->field = (void *)get_dyn_sym(lib, #field);                    \
+        if (!ctx->field) {                                                \
+            av_log(avctx, AV_LOG_ERROR, "[Ascend] missing symbol %s\n",  \
+                   #field);                                               \
+            return AVERROR_EXTERNAL;                                      \
+        }                                                                 \
+    } while (0)
+
+#define LOAD_OPT_SYM(field, lib)                                          \
+    ctx->field = (void *)get_dyn_sym(lib, #field)
+
+    LOAD_SYM(aclrtSetCurrentContext, acl);
+    LOAD_SYM(aclrtProcessReport, acl);
+    LOAD_SYM(aclrtMallocHost, acl);
+    LOAD_SYM(aclrtFreeHost, acl);
+    LOAD_SYM(aclrtMemcpy, acl);
+
+    LOAD_SYM(acldvppMalloc, dvpp);
+    LOAD_SYM(acldvppFree, dvpp);
+
+    LOAD_SYM(aclvdecCreateChannelDesc, dvpp);
+    LOAD_SYM(aclvdecDestroyChannelDesc, dvpp);
+    LOAD_SYM(aclvdecSetChannelDescChannelId, dvpp);
+    LOAD_SYM(aclvdecSetChannelDescThreadId, dvpp);
+    LOAD_SYM(aclvdecSetChannelDescCallback, dvpp);
+    LOAD_SYM(aclvdecSetChannelDescEnType, dvpp);
+    LOAD_SYM(aclvdecSetChannelDescOutPicFormat, dvpp);
+    LOAD_OPT_SYM(aclvdecSetChannelDescOutPicWidth, dvpp);
+    LOAD_OPT_SYM(aclvdecSetChannelDescOutPicHeight, dvpp);
+    LOAD_SYM(aclvdecCreateChannel, dvpp);
+    LOAD_SYM(aclvdecDestroyChannel, dvpp);
+
+    LOAD_SYM(acldvppCreateStreamDesc, dvpp);
+    LOAD_SYM(acldvppDestroyStreamDesc, dvpp);
+    LOAD_SYM(acldvppSetStreamDescData, dvpp);
+    LOAD_SYM(acldvppSetStreamDescSize, dvpp);
+    LOAD_SYM(acldvppSetStreamDescEos, dvpp);
+    LOAD_SYM(acldvppGetStreamDescData, dvpp);
+
+    LOAD_SYM(acldvppCreatePicDesc, dvpp);
+    LOAD_SYM(acldvppDestroyPicDesc, dvpp);
+    LOAD_SYM(acldvppSetPicDescData, dvpp);
+    LOAD_SYM(acldvppSetPicDescSize, dvpp);
+    LOAD_SYM(acldvppSetPicDescFormat, dvpp);
+    LOAD_SYM(acldvppSetPicDescWidth, dvpp);
+    LOAD_SYM(acldvppSetPicDescHeight, dvpp);
+    LOAD_SYM(acldvppSetPicDescWidthStride, dvpp);
+    LOAD_SYM(acldvppSetPicDescHeightStride, dvpp);
+    LOAD_SYM(acldvppGetPicDescData, dvpp);
+    LOAD_SYM(acldvppGetPicDescWidth, dvpp);
+    LOAD_SYM(acldvppGetPicDescHeight, dvpp);
+    LOAD_SYM(acldvppGetPicDescWidthStride, dvpp);
+    LOAD_SYM(acldvppGetPicDescHeightStride, dvpp);
+    LOAD_SYM(acldvppGetPicDescRetCode, dvpp);
+
+    LOAD_SYM(aclvdecSendFrame, dvpp);
+
+#undef LOAD_SYM
+#undef LOAD_OPT_SYM
+    return 0;
+}
+
+static acldvppStreamFormat map_en_type(const AVCodecContext *avctx)
+{
+    if (avctx->codec_id == AV_CODEC_ID_HEVC)
+        return H265_MAIN_LEVEL;
+
+    switch (avctx->profile) {
+    case AV_PROFILE_H264_BASELINE:
+    case AV_PROFILE_H264_CONSTRAINED_BASELINE:
+        return H264_BASELINE_LEVEL;
+    case AV_PROFILE_H264_MAIN:
+        return H264_MAIN_LEVEL;
+    default:
+        return H264_HIGH_LEVEL;
+    }
+}
+
+static void get_dimensions(AVCodecContext *avctx, int *width, int *height,
+                           int *coded_w, int *coded_h)
+{
+    *coded_w = avctx->coded_width  > 0 ? avctx->coded_width  : avctx->width;
+    *coded_h = avctx->coded_height > 0 ? avctx->coded_height : avctx->height;
+    *width   = avctx->width        > 0 ? avctx->width        : *coded_w;
+    *height  = avctx->height       > 0 ? avctx->height       : *coded_h;
+    if (*coded_w <= 0)
+        *coded_w = *width > 0 ? *width : 1920;
+    if (*coded_h <= 0)
+        *coded_h = *height > 0 ? *height : 1080;
+    if (*width <= 0)
+        *width = *coded_w;
+    if (*height <= 0)
+        *height = *coded_h;
+}
+
+static void ascend_destroy_channel(AscendDecodeContext *ctx)
+{
+    if (!ctx->channel_desc)
+        return;
+    if (ctx->aclvdecDestroyChannel)
+        ctx->aclvdecDestroyChannel(ctx->channel_desc);
+    if (ctx->aclvdecDestroyChannelDesc)
+        ctx->aclvdecDestroyChannelDesc(ctx->channel_desc);
+    ctx->channel_desc = NULL;
+    ctx->channel_width = 0;
+    ctx->channel_height = 0;
+}
+
+static int ascend_ensure_hw_frames(AVCodecContext *avctx, int width, int height)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    AVHWFramesContext *frames_ctx;
+    int ret;
+
+    if (avctx->hw_frames_ctx) {
+        frames_ctx = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+        if (frames_ctx->width == width && frames_ctx->height == height)
+            return 0;
+        av_buffer_unref(&avctx->hw_frames_ctx);
+    }
+
+    if (!ctx->hw_device_ref) {
+        if (avctx->hw_device_ctx) {
+            ctx->hw_device_ref = av_buffer_ref(avctx->hw_device_ctx);
+        } else {
+            char dev_str[16];
+            snprintf(dev_str, sizeof(dev_str), "%d", ctx->device_id);
+            ret = av_hwdevice_ctx_create(&ctx->hw_device_ref,
+                                         AV_HWDEVICE_TYPE_ASCEND,
+                                         dev_str, NULL, 0);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    av_buffer_unref(&ctx->hw_frames_ref);
+    ctx->hw_frames_ref = av_hwframe_ctx_alloc(ctx->hw_device_ref);
+    if (!ctx->hw_frames_ref)
+        return AVERROR(ENOMEM);
+
+    frames_ctx            = (AVHWFramesContext *)ctx->hw_frames_ref->data;
+    frames_ctx->format    = AV_PIX_FMT_ASCEND;
+    frames_ctx->sw_format = AV_PIX_FMT_NV12;
+    frames_ctx->width     = width;
+    frames_ctx->height    = height;
+
+    ret = av_hwframe_ctx_init(ctx->hw_frames_ref);
+    if (ret < 0) {
+        av_buffer_unref(&ctx->hw_frames_ref);
+        return ret;
+    }
+
+    avctx->hw_frames_ctx = av_buffer_ref(ctx->hw_frames_ref);
+    return avctx->hw_frames_ctx ? 0 : AVERROR(ENOMEM);
+}
+
+static int ascend_create_channel(AVCodecContext *avctx, int coded_w, int coded_h)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    uint32_t stride_w = FFALIGN(coded_w, ASCEND_ALIGN_WIDTH);
+    uint32_t stride_h = FFALIGN(coded_h, ASCEND_ALIGN_HEIGHT);
+    int start_ch = (ctx->channel_id >= 0 && ctx->channel_id < 256)
+                   ? ctx->channel_id : ((getpid() + atomic_fetch_add(&ascend_channel_counter, 1)) & 0xff);
+    int ch = start_ch;
+    aclError ret = ACL_ERROR_INVALID_PARAM;
+
+    /* Auto-hunt available channel ID across [0..255] with a clean descriptor per attempt */
+    for (int attempt = 0; attempt < 256; attempt++) {
+        ctx->channel_desc = ctx->aclvdecCreateChannelDesc();
+        if (!ctx->channel_desc) {
+            av_log(avctx, AV_LOG_ERROR, "[Ascend] aclvdecCreateChannelDesc failed\n");
+            return AVERROR_EXTERNAL;
+        }
+
+        ret  = ctx->aclvdecSetChannelDescChannelId(ctx->channel_desc, (uint32_t)ch);
+        ret |= ctx->aclvdecSetChannelDescThreadId(ctx->channel_desc, ctx->callback_tid);
+        ret |= ctx->aclvdecSetChannelDescCallback(ctx->channel_desc, ascend_vdec_callback);
+        ret |= ctx->aclvdecSetChannelDescEnType(ctx->channel_desc, map_en_type(avctx));
+        ret |= ctx->aclvdecSetChannelDescOutPicFormat(ctx->channel_desc,
+                                                      PIXEL_FORMAT_YUV_SEMIPLANAR_420);
+        if (ctx->aclvdecSetChannelDescOutPicWidth)
+            ctx->aclvdecSetChannelDescOutPicWidth(ctx->channel_desc, coded_w);
+        if (ctx->aclvdecSetChannelDescOutPicHeight)
+            ctx->aclvdecSetChannelDescOutPicHeight(ctx->channel_desc, coded_h);
+
+        if (ret != ACL_SUCCESS) {
+            av_log(avctx, AV_LOG_ERROR, "[Ascend] channel descriptor setup failed\n");
+            ctx->aclvdecDestroyChannelDesc(ctx->channel_desc);
+            ctx->channel_desc = NULL;
+            return AVERROR_EXTERNAL;
+        }
+
+        ret = ctx->aclvdecCreateChannel(ctx->channel_desc);
+        if (ret == ACL_SUCCESS) {
+            ctx->channel_id = ch;
+            break;
+        }
+        ctx->aclvdecDestroyChannelDesc(ctx->channel_desc);
+        ctx->channel_desc = NULL;
+        ch = (ch + 1) % 256;
+    }
+
+    if (ret != ACL_SUCCESS || !ctx->channel_desc) {
+        av_log(avctx, AV_LOG_ERROR,
+               "[Ascend] aclvdecCreateChannel(ch=%d..%d, %dx%d) failed: 0x%x\n",
+               start_ch, (start_ch + 255) % 256, coded_w, coded_h, ret);
+        return AVERROR_EXTERNAL;
+    }
+
+    ctx->channel_width  = coded_w;
+    ctx->channel_height = coded_h;
+    av_log(avctx, AV_LOG_INFO,
+           "[Ascend] DVPP VDEC ready (device=%d, ch=%d, %dx%d, stride=%ux%u, mode=%s)\n",
+           ctx->device_id, ctx->channel_id, coded_w, coded_h, stride_w, stride_h,
+           avctx->pix_fmt == AV_PIX_FMT_ASCEND ? "device-zero-copy" : "host-pinned");
+    return 0;
+}
+
+static int ascend_ensure_channel(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    int width, height, coded_w, coded_h;
+    int ret;
+
+    get_dimensions(avctx, &width, &height, &coded_w, &coded_h);
+    ret = ff_set_dimensions(avctx, width, height);
+    if (ret < 0)
+        return ret;
+
+    if (avctx->pix_fmt == AV_PIX_FMT_ASCEND) {
+        ret = ascend_ensure_hw_frames(avctx, width, height);
+        if (ret < 0)
+            return ret;
+    }
+
+    if (ctx->channel_desc &&
+        coded_w == ctx->channel_width && coded_h == ctx->channel_height)
+        return 0;
+
+    if (ctx->channel_desc) {
+        av_log(avctx, AV_LOG_WARNING,
+               "[Ascend] resolution changed %dx%d -> %dx%d, recreating channel\n",
+               ctx->channel_width, ctx->channel_height, coded_w, coded_h);
+
+        /* Wait for existing in-flight frames before recreating to prevent cross-resolution pool pollution */
+        while (atomic_load(&ctx->in_flight) > 0) {
+            struct timespec ts;
+            clock_gettime(CLOCK_REALTIME, &ts);
+            ts.tv_nsec += 20 * 1000000;
+            if (ts.tv_nsec >= 1000000000) {
+                ts.tv_sec++;
+                ts.tv_nsec -= 1000000000;
+            }
+            pthread_mutex_lock(&ctx->lock);
+            pthread_cond_timedwait(&ctx->cond, &ctx->lock, &ts);
+            pthread_mutex_unlock(&ctx->lock);
+        }
+
+        ascend_destroy_channel(ctx);
+        queue_clear(ctx);
+
+        /* Mark old pool closed and unref it; allocate a brand new pool for the new resolution */
+        out_pool_clear(ctx, 1);
+        out_pool_unref(ctx->out_pool);
+        ctx->out_pool = out_pool_alloc(ctx->cref);
+        if (!ctx->out_pool)
+            return AVERROR(ENOMEM);
+
+        ascend_free_host_pool(ctx);
+        atomic_store(&ctx->in_flight, 0);
+        ctx->eof_reached = ctx->eos_sent = ctx->eos_done = 0;
+    }
+    return ascend_create_channel(avctx, coded_w, coded_h);
+}
+
+static int ascend_send_packet(AVCodecContext *avctx, const AVPacket *pkt)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    acldvppStreamDesc *stream = NULL;
+    acldvppPicDesc *pic = NULL;
+    AscendFrameMeta *meta = NULL;
+    void *in_dev = NULL;
+    size_t in_cap = 0;
+    void *out_dev = NULL;
+    int width, height, coded_w, coded_h;
+    uint32_t stride_w, stride_h;
+    size_t out_size;
+    int attempts = 0;
+    int ret;
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    get_dimensions(avctx, &width, &height, &coded_w, &coded_h);
+    ret = ascend_ensure_channel(avctx);
+    if (ret < 0)
+        return ret;
+
+    stride_w = FFALIGN(coded_w, ASCEND_ALIGN_WIDTH);
+    stride_h = FFALIGN(coded_h, ASCEND_ALIGN_HEIGHT);
+    out_size = (size_t)stride_w * stride_h * 3 / 2;
+
+    if (!pkt->size)
+        return AVERROR(EINVAL);
+
+    ret = in_pool_get(ctx, pkt->size, &in_dev, &in_cap);
+    if (ret < 0)
+        return ret;
+
+    if (ctx->aclrtMemcpy(in_dev, in_cap, pkt->data, pkt->size,
+                         ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR_EXTERNAL;
+    }
+
+    stream = ctx->acldvppCreateStreamDesc();
+    if (!stream) {
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR(ENOMEM);
+    }
+    if (ctx->acldvppSetStreamDescData(stream, in_dev) != ACL_SUCCESS ||
+        ctx->acldvppSetStreamDescSize(stream, pkt->size) != ACL_SUCCESS) {
+        ctx->acldvppDestroyStreamDesc(stream);
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR_EXTERNAL;
+    }
+
+    out_dev = out_pool_get(ctx, out_size);
+    if (!out_dev) {
+        ctx->acldvppDestroyStreamDesc(stream);
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR(ENOMEM);
+    }
+    pic = ctx->acldvppCreatePicDesc();
+    if (!pic ||
+        ctx->acldvppSetPicDescData(pic, out_dev) != ACL_SUCCESS ||
+        ctx->acldvppSetPicDescSize(pic, out_size) != ACL_SUCCESS ||
+        ctx->acldvppSetPicDescFormat(pic, PIXEL_FORMAT_YUV_SEMIPLANAR_420) != ACL_SUCCESS ||
+        ctx->acldvppSetPicDescWidth(pic, coded_w) != ACL_SUCCESS ||
+        ctx->acldvppSetPicDescHeight(pic, coded_h) != ACL_SUCCESS ||
+        ctx->acldvppSetPicDescWidthStride(pic, stride_w) != ACL_SUCCESS ||
+        ctx->acldvppSetPicDescHeightStride(pic, stride_h) != ACL_SUCCESS) {
+        if (pic)
+            ctx->acldvppDestroyPicDesc(pic);
+        out_pool_put(ctx, out_dev);
+        ctx->acldvppDestroyStreamDesc(stream);
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR_EXTERNAL;
+    }
+
+    meta = av_mallocz(sizeof(*meta));
+    if (!meta) {
+        ctx->acldvppDestroyPicDesc(pic);
+        out_pool_put(ctx, out_dev);
+        ctx->acldvppDestroyStreamDesc(stream);
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR(ENOMEM);
+    }
+    meta->ctx = ctx;
+    meta->in_cap = in_cap;
+    meta->pts = pkt->pts;
+    meta->dts = pkt->dts;
+
+    atomic_fetch_add(&ctx->in_flight, 1);
+    for (;;) {
+        aclError acl_ret = ctx->aclvdecSendFrame(ctx->channel_desc, stream, pic,
+                                                 NULL, meta);
+        if (acl_ret == ACL_SUCCESS)
+            break;
+        if ((int)acl_ret == ASCEND_VDEC_BUF_FULL && attempts++ < 5000 &&
+            atomic_load(&ctx->running)) {
+            av_usleep(1000);
+            continue;
+        }
+        atomic_fetch_sub(&ctx->in_flight, 1);
+        av_log(avctx, AV_LOG_ERROR,
+               "[Ascend] aclvdecSendFrame failed: 0x%x\n", acl_ret);
+        av_free(meta);
+        ctx->acldvppDestroyPicDesc(pic);
+        out_pool_put(ctx, out_dev);
+        ctx->acldvppDestroyStreamDesc(stream);
+        in_pool_put(ctx, in_dev, in_cap);
+        return AVERROR_EXTERNAL;
+    }
+
+    return 0;
+}
+
+static int ascend_send_eos(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    acldvppStreamDesc *stream;
+    int attempts = 0;
+    aclError ret;
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    if (!ctx->channel_desc) {
+        ctx->eos_done = 1;
+        return 0;
+    }
+
+    stream = ctx->acldvppCreateStreamDesc();
+    if (!stream)
+        return AVERROR(ENOMEM);
+    ret = ctx->acldvppSetStreamDescEos(stream, 1);
+    if (ret != ACL_SUCCESS) {
+        ctx->acldvppDestroyStreamDesc(stream);
+        return AVERROR_EXTERNAL;
+    }
+
+    for (;;) {
+        ret = ctx->aclvdecSendFrame(ctx->channel_desc, stream, NULL, NULL, NULL);
+        if (ret == ACL_SUCCESS)
+            break;
+        if ((int)ret == ASCEND_VDEC_BUF_FULL && attempts++ < 5000 &&
+            atomic_load(&ctx->running)) {
+            av_usleep(1000);
+            continue;
+        }
+        ctx->acldvppDestroyStreamDesc(stream);
+        av_log(avctx, AV_LOG_ERROR, "[Ascend] EOS send failed: 0x%x\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    ctx->acldvppDestroyStreamDesc(stream);
+    return 0;
+}
+
+static int ascend_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    AscendFrame item;
+    int poll_waited = 0;
+    int sent_pkt = 0;
+    int waited_ms = 0;
+    int ret;
+
+    if (!ctx->initialized)
+        return AVERROR(EINVAL);
+    if (ctx->context) {
+        ret = ctx->aclrtSetCurrentContext(ctx->context);
+        if (ret != ACL_SUCCESS)
+            return AVERROR_EXTERNAL;
+    }
+
+    while (!ctx->eof_reached) {
+        ret = ff_decode_get_packet(avctx, ctx->pkt);
+        if (ret == AVERROR_EOF) {
+            ctx->eof_reached = 1;
+            break;
+        } else if (ret == AVERROR(EAGAIN)) {
+            break;
+        } else if (ret < 0) {
+            return ret;
+        }
+
+        ret = ascend_send_packet(avctx, ctx->pkt);
+        av_packet_unref(ctx->pkt);
+        if (ret < 0)
+            return ret;
+        sent_pkt = 1;
+    }
+
+    for (;;) {
+        pthread_mutex_lock(&ctx->lock);
+        if (ctx->queue_count > 0) {
+            item = ctx->queue[ctx->queue_head];
+            ctx->queue_head = (ctx->queue_head + 1) % ASCEND_QUEUE_DEPTH;
+            ctx->queue_count--;
+            pthread_mutex_unlock(&ctx->lock);
+            break;
+        }
+        if (ctx->eos_done) {
+            pthread_mutex_unlock(&ctx->lock);
+            return AVERROR_EOF;
+        }
+        if (!ctx->eof_reached) {
+            if (sent_pkt && !poll_waited &&
+                atomic_load(&ctx->in_flight) >= 8) {
+                struct timespec ts;
+                poll_waited = 1;
+                clock_gettime(CLOCK_REALTIME, &ts);
+                ts.tv_nsec += 5 * 1000000;
+                if (ts.tv_nsec >= 1000000000) {
+                    ts.tv_sec++;
+                    ts.tv_nsec -= 1000000000;
+                }
+                pthread_cond_timedwait(&ctx->cond, &ctx->lock, &ts);
+                pthread_mutex_unlock(&ctx->lock);
+                continue;
+            }
+            pthread_mutex_unlock(&ctx->lock);
+            return AVERROR(EAGAIN);
+        }
+        if (!ctx->eos_sent) {
+            ctx->eos_sent = 1;
+            pthread_mutex_unlock(&ctx->lock);
+            ret = ascend_send_eos(avctx);
+            if (ret < 0)
+                return ret;
+            continue;
+        }
+        if (!atomic_load(&ctx->in_flight)) {
+            ctx->eos_done = 1;
+            pthread_mutex_unlock(&ctx->lock);
+            return AVERROR_EOF;
+        }
+        {
+            struct timespec ts;
+            clock_gettime(CLOCK_REALTIME, &ts);
+            ts.tv_nsec += 50 * 1000000;
+            if (ts.tv_nsec >= 1000000000) {
+                ts.tv_sec++;
+                ts.tv_nsec -= 1000000000;
+            }
+            pthread_cond_timedwait(&ctx->cond, &ctx->lock, &ts);
+        }
+        if (ctx->queue_count > 0) {
+            pthread_mutex_unlock(&ctx->lock);
+            continue;
+        }
+        waited_ms += 50;
+        if (waited_ms >= 1000) {
+            ctx->eos_done = 1;
+            pthread_mutex_unlock(&ctx->lock);
+            return AVERROR_EOF;
+        }
+        pthread_mutex_unlock(&ctx->lock);
+    }
+
+    {
+        void *dev = ctx->acldvppGetPicDescData(item.pic);
+        uint32_t desc_w = ctx->acldvppGetPicDescWidth(item.pic);
+        uint32_t desc_h = ctx->acldvppGetPicDescHeight(item.pic);
+        uint32_t stride_w = ctx->acldvppGetPicDescWidthStride(item.pic);
+        uint32_t stride_h = ctx->acldvppGetPicDescHeightStride(item.pic);
+        int width = desc_w ? (int)desc_w : (avctx->width > 0 ? avctx->width : 1920);
+        int height = desc_h ? (int)desc_h : (avctx->height > 0 ? avctx->height : 1080);
+        int chroma_h;
+        size_t y_size, uv_size, copy_size;
+
+        if (!dev || !stride_w || !stride_h || width <= 0 || height <= 0 ||
+            stride_w < (uint32_t)width || stride_h < (uint32_t)height) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "[Ascend] invalid output desc: %dx%d stride %ux%u\n",
+                   width, height, stride_w, stride_h);
+            ret = AVERROR_EXTERNAL;
+            goto fail_pic;
+        }
+
+        if (desc_w && desc_h && (avctx->width != (int)desc_w || avctx->height != (int)desc_h))
+            ff_set_dimensions(avctx, desc_w, desc_h);
+
+        y_size = (size_t)stride_w * stride_h;
+        chroma_h = (height + 1) / 2;
+        uv_size = (size_t)stride_w * chroma_h;
+        copy_size = y_size + uv_size;
+
+        frame->width  = width;
+        frame->height = height;
+        frame->format = avctx->pix_fmt;
+        ret = ff_decode_frame_props(avctx, frame);
+        if (ret < 0)
+            goto fail_pic;
+        frame->pts     = item.pts;
+        frame->pkt_dts = item.dts;
+
+        if (avctx->pix_fmt == AV_PIX_FMT_ASCEND) {
+            ret = ascend_ensure_hw_frames(avctx, width, height);
+            if (ret < 0)
+                goto fail_pic;
+
+            atomic_fetch_add(&ctx->out_pool->refs, 1);
+            frame->buf[0] = av_buffer_create((uint8_t *)dev, copy_size,
+                                             ascend_dev_frame_free,
+                                             ctx->out_pool, 0);
+            if (!frame->buf[0]) {
+                out_pool_unref(ctx->out_pool);
+                ret = AVERROR(ENOMEM);
+                goto fail_pic;
+            }
+            frame->hw_frames_ctx = av_buffer_ref(avctx->hw_frames_ctx);
+            if (!frame->hw_frames_ctx) {
+                ret = AVERROR(ENOMEM);
+                av_frame_unref(frame);
+                ctx->acldvppDestroyPicDesc(item.pic);
+                return ret;
+            }
+            frame->data[0]     = (uint8_t *)dev;
+            frame->linesize[0] = (int)stride_w;
+            frame->data[1]     = (uint8_t *)dev + y_size;
+            frame->linesize[1] = (int)stride_w;
+        } else {
+            ret = ascend_ensure_host_pool(ctx, copy_size);
+            if (ret < 0)
+                goto fail_pic;
+
+            frame->buf[0] = av_buffer_pool_get(ctx->host_frame_pool);
+            if (!frame->buf[0]) {
+                ret = AVERROR(ENOMEM);
+                goto fail_pic;
+            }
+
+            if (ctx->aclrtMemcpy(frame->buf[0]->data, copy_size,
+                                 dev, copy_size,
+                                 ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
+                ret = AVERROR_EXTERNAL;
+                goto fail_pic;
+            }
+            out_pool_put(ctx, dev);
+
+            frame->data[0]     = frame->buf[0]->data;
+            frame->linesize[0] = (int)stride_w;
+            frame->data[1]     = frame->buf[0]->data + y_size;
+            frame->linesize[1] = (int)stride_w;
+        }
+    }
+    ctx->acldvppDestroyPicDesc(item.pic);
+    return 0;
+
+fail_pic:
+    {
+        void *dev = ctx->acldvppGetPicDescData(item.pic);
+        if (dev)
+            out_pool_put(ctx, dev);
+    }
+    ctx->acldvppDestroyPicDesc(item.pic);
+    av_frame_unref(frame);
+    return ret;
+}
+
+static av_cold void ascend_flush(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    int width, height, coded_w, coded_h;
+
+    if (!ctx->initialized)
+        return;
+    if (ctx->context)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    ascend_destroy_channel(ctx);
+    queue_clear(ctx);
+    if (ctx->pkt)
+        av_packet_unref(ctx->pkt);
+    atomic_store(&ctx->in_flight, 0);
+    ctx->eof_reached = ctx->eos_sent = ctx->eos_done = 0;
+
+    get_dimensions(avctx, &width, &height, &coded_w, &coded_h);
+    if (coded_w > 0 && coded_h > 0 && !ctx->channel_desc)
+        ascend_create_channel(avctx, coded_w, coded_h);
+}
+
+static av_cold int ascend_init_decoder(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+    static const enum AVPixelFormat pix_fmts_hw[] = {
+        AV_PIX_FMT_ASCEND,
+        AV_PIX_FMT_NV12,
+        AV_PIX_FMT_NONE
+    };
+    int ret;
+
+    ctx->codec_id = avctx->codec_id;
+    ctx->queue_head = ctx->queue_tail = ctx->queue_count = 0;
+    ctx->in_pool_count = 0;
+    ctx->eof_reached = ctx->eos_sent = ctx->eos_done = 0;
+    atomic_init(&ctx->running, 0);
+    atomic_init(&ctx->in_flight, 0);
+    atomic_init(&ctx->cb_count, 0);
+    pthread_mutex_init(&ctx->lock, NULL);
+    pthread_cond_init(&ctx->cond, NULL);
+    pthread_cond_init(&ctx->thread_started, NULL);
+
+    if (avctx->hw_frames_ctx) {
+        AVHWFramesContext *frames_ctx = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+        AVAscendDeviceContext *hwctx = frames_ctx->device_ctx->hwctx;
+        ctx->device_id = hwctx->device_id;
+    } else if (avctx->hw_device_ctx) {
+        AVHWDeviceContext *dev_ctx = (AVHWDeviceContext *)avctx->hw_device_ctx->data;
+        if (dev_ctx->type == AV_HWDEVICE_TYPE_ASCEND) {
+            AVAscendDeviceContext *hwctx = dev_ctx->hwctx;
+            ctx->device_id = hwctx->device_id;
+        }
+    }
+
+    ctx->pkt = av_packet_alloc();
+    if (!ctx->pkt)
+        return AVERROR(ENOMEM);
+
+    AscendContextRef *cref = av_mallocz(sizeof(*cref));
+    if (!cref)
+        return AVERROR(ENOMEM);
+    atomic_init(&cref->refs, 1);
+    cref->device_id = ctx->device_id;
+
+    ret = av_ascend_global_acquire(ctx->device_id, &cref->acl_lib,
+                                   &cref->dvpp_lib, (void **)&cref->context, avctx);
+    if (ret < 0) {
+        av_free(cref);
+        return ret;
+    }
+    cref->aclrtSetCurrentContext = (void *)get_dyn_sym(cref->acl_lib, "aclrtSetCurrentContext");
+    cref->acldvppFree            = (void *)get_dyn_sym(cref->dvpp_lib, "acldvppFree");
+
+    ctx->cref         = cref;
+    ctx->context      = cref->context;
+    ctx->acl_lib      = cref->acl_lib;
+    ctx->dvpp_lib     = cref->dvpp_lib;
+    ctx->acl_acquired = 1;
+
+    ret = load_symbols(avctx);
+    if (ret < 0)
+        return ret;
+
+    ctx->out_pool = out_pool_alloc(ctx->cref);
+    if (!ctx->out_pool)
+        return AVERROR(ENOMEM);
+
+    if (ctx->channel_id < 0)
+        ctx->channel_id = (getpid() + atomic_fetch_add(&ascend_channel_counter, 1)) & 0xff;
+
+    atomic_store(&ctx->running, 1);
+    ret = pthread_create(&ctx->callback_thread, NULL, ascend_callback_thread, ctx);
+    if (ret) {
+        atomic_store(&ctx->running, 0);
+        av_log(avctx, AV_LOG_ERROR, "[Ascend] pthread_create failed: %d\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    pthread_mutex_lock(&ctx->lock);
+    while (!ctx->callback_thread_started)
+        pthread_cond_wait(&ctx->thread_started, &ctx->lock);
+    pthread_mutex_unlock(&ctx->lock);
+
+    avctx->sw_pix_fmt = AV_PIX_FMT_NV12;
+    if (ctx->device_output) {
+        avctx->pix_fmt = AV_PIX_FMT_ASCEND;
+    } else {
+        ret = ff_get_format(avctx, pix_fmts_hw);
+        if (ret < 0)
+            return ret;
+        avctx->pix_fmt = ret;
+    }
+
+    if (avctx->pix_fmt == AV_PIX_FMT_ASCEND) {
+        int w, h, cw, ch;
+        get_dimensions(avctx, &w, &h, &cw, &ch);
+        ret = ascend_ensure_hw_frames(avctx, w, h);
+        if (ret < 0)
+            return ret;
+    }
+
+    ctx->initialized = 1;
+
+    av_log(avctx, AV_LOG_INFO,
+           "[Ascend] DVPP decoder initialized (device=%d, channel=%d, pix_fmt=%s)\n",
+           ctx->device_id, ctx->channel_id, av_get_pix_fmt_name(avctx->pix_fmt));
+    return 0;
+}
+
+static av_cold int ascend_close_decoder(AVCodecContext *avctx)
+{
+    AscendDecodeContext *ctx = avctx->priv_data;
+
+    if (ctx->context && ctx->aclrtSetCurrentContext)
+        ctx->aclrtSetCurrentContext(ctx->context);
+
+    ascend_destroy_channel(ctx);
+    if (ctx->callback_thread_started) {
+        atomic_store(&ctx->running, 0);
+        pthread_join(ctx->callback_thread, NULL);
+        ctx->callback_thread_started = 0;
+    }
+    queue_clear(ctx);
+    out_pool_clear(ctx, 1);
+    out_pool_unref(ctx->out_pool);
+    ctx->out_pool = NULL;
+    in_pool_clear(ctx);
+    ascend_free_host_pool(ctx);
+    av_packet_free(&ctx->pkt);
+    av_buffer_unref(&ctx->hw_frames_ref);
+    av_buffer_unref(&ctx->hw_device_ref);
+    atomic_store(&ctx->in_flight, 0);
+    if (ctx->cref) {
+        AscendContextRef *cref = ctx->cref;
+        ctx->cref = NULL;
+        ctx->context = NULL;
+        ctx->acl_acquired = 0;
+        if (atomic_fetch_sub(&cref->refs, 1) == 1) {
+            av_ascend_global_release(cref->device_id, cref->context);
+            av_free(cref);
+        }
+    }
+    ctx->dvpp_lib = ctx->acl_lib = NULL;
+
+    pthread_cond_destroy(&ctx->thread_started);
+    pthread_cond_destroy(&ctx->cond);
+    pthread_mutex_destroy(&ctx->lock);
+    return 0;
+}
